函数 输出代码(上下文: 列表) -> 字符串:
    # 用 连接 一次成型：逐行字符串相加是 O(n²)，大文件会卡死
    行们 = 上下文[0]
    如果 长度(行们) == 0:
        返回 ""
    返回 合并(行们, "\n") + "\n"

# ---- 语法树转储（调试用）：输入以 #dump 开头时只打印语法树 ----

# ======================================================================
# 入口：读源码 -> 词法 -> 语法 -> 代码生成 -> 输出 LLVM IR
#   用法：./lc < prog.light > prog.ll
#   链接：clang prog.ll liblightrt.a -lstdc++ -lpthread -o prog
# ======================================================================

函数 主程序() -> 整数:
    源码 = 读入()
    记号 = 词法(源码)
    如果 源码.切片(0, 7) == "#tokens":
        k = 0
        当 k < 长度(记号):
            t = 记号[k]
            打印(字符串(k) + ": " + 元素文本(t, 0) + " [" + 元素文本(t, 1) + "] @" + 字符串(元素(t, 2)))
            k = k + 1
        返回 0
    项目 = 解析程序(记号, 0, [])
    如果 源码.切片(0, 5) == "#dump":
        打印语法块(项目, "")
        返回 0
    上下文 = [[], 0, 0, 0, [], [], [], "", "", [], 0, "", "", 0, [], []]
    符号表 = 建符号表(项目)
    上下文[4] = 符号表
    发射(上下文, "; 由 Light 自举编译器生成")
    发射(上下文, "target triple = \"x86_64-linux-gnu\"")
    发射(上下文, "")
    声明们 = 运行时声明()
    i = 0
    当 i < 长度(声明们):
        发射(上下文, 声明们[i])
        i = i + 1
    生成主函数(上下文, 项目)
    i = 0
    当 i < 长度(项目):
        项 = 项目[i]
        如果 元素文本(项, 0) == "函":
            生成函数(上下文, 项)
        i = i + 1
    # 线程函数在所有主函数之后统一补上
    i = 0
    当 i < 长度(上下文[15]):
        生成线程函数(上下文, 上下文[15][i])
        i = i + 1
    i = 0
    当 i < 长度(上下文[9]):
        发射(上下文, 上下文[9][i])
        i = i + 1
    打印(输出代码(上下文))
    返回 0

主程序()
