# LightLang 自举编译器（stage1 源码）
#
# 本文件用 LightLang 写成，编译 LightLang 源码，输出 LLVM IR 到标准输出。
#   用法：./lc < prog.light > prog.ll
#   链接：clang prog.ll liblightrt.a -lstdc++ -lpthread -o prog
#
# 自举链：
#   stage0 = Rust 写的 lightc      编译本文件 -> stage1
#   stage1                          编译本文件 -> stage2
#   stage2                          编译本文件 -> stage3
#   stage2 == stage3 即完成自举证明（见 scripts/bootstrap.sh）
#
# 代码生成策略：
#   - 所有值都是 i64；浮点用 double，需要时 bitcast
#   - 局部变量在入口块 alloca，读写走内存，因此循环不需要 phi
#   - 不做内存回收：编译器进程短命，泄漏可接受
#   - 只支持下面这个子集，本文件自身也只用这个子集

# ======================================================================
# 词法分析：源码 -> 记号列表
#   记号 = [类型, 值, 行号]
#   类型：名 整 浮 串 符 增 减 结 错
# ======================================================================

函数 是数字字节(c: 整数) -> 布尔:
    返回 c >= 48 且 c <= 57

函数 是字母字节(c: 整数) -> 布尔:
    返回 (c >= 65 且 c <= 90) 或 (c >= 97 且 c <= 122) 或 c == 95

函数 是名字首字节(c: 整数) -> 布尔:
    # >= 128 是 UTF-8 多字节，中文关键字靠它识别
    返回 是字母字节(c) 或 c >= 128

函数 是名字字节(c: 整数) -> 布尔:
    返回 是名字首字节(c) 或 是数字字节(c)

函数 去注释(行: 字符串) -> 字符串:
    # 逐字符扫描：字符串里的 # 不是注释；遇到注释符就截断
    出 = ""
    i = 0
    在串 = 假
    当 i < 长度(行):
        c = 行[i]
        如果 在串:
            如果 c == 92 且 i + 1 < 长度(行):
                出 = 出 + 字符(c) + 字符(行[i + 1])
                i = i + 2
                继续
            出 = 出 + 字符(c)
            如果 c == 34:
                在串 = 假
            i = i + 1
            继续
        如果 c == 34:
            在串 = 真
            出 = 出 + 字符(c)
            i = i + 1
            继续
        如果 c == 35:
            返回 出
        出 = 出 + 字符(c)
        i = i + 1
    返回 出

函数 前导空格(行: 字符串) -> 整数:
    i = 0
    当 i < 长度(行):
        如果 行[i] != 32 且 行[i] != 9:
            返回 i
        i = i + 1
    返回 长度(行)

函数 双字符算符(行: 字符串, i: 整数) -> 字符串:
    如果 i + 1 >= 长度(行):
        返回 ""
    返回 行.切片(i, i + 2)

函数 简单算符(c: 整数) -> 布尔:
    返回 c == 43 或 c == 45 或 c == 42 或 c == 47 或 c == 37 或 c == 40 或 c == 41 或 c == 91 或 c == 93 或 c == 44 或 c == 58 或 c == 61 或 c == 60 或 c == 62 或 c == 46

函数 扫描一行(记号: 列表, 行: 字符串, 行号: 整数, 从: 整数) -> 整数:
    i = 从
    n = 长度(行)
    当 i < n:
        c = 行[i]
        如果 c == 32 或 c == 9:
            i = i + 1
            继续
        如果 c == 34:
            j = i + 1
            内容 = ""
            当 j < n:
                如果 行[j] == 34:
                    追加(记号, ["串", 内容, 行号])
                    返回 j + 1
                # 反斜杠转义：\n \t \\ \"
                如果 行[j] == 92 且 j + 1 < n:
                    e = 行[j + 1]
                    如果 e == 110:
                        内容 = 内容 + 字符(10)
                    否则如果 e == 116:
                        内容 = 内容 + 字符(9)
                    否则如果 e == 92:
                        内容 = 内容 + 字符(92)
                    否则如果 e == 34:
                        内容 = 内容 + 字符(34)
                    否则:
                        内容 = 内容 + 字符(92) + 字符(e)
                    j = j + 2
                    继续
                内容 = 内容 + 字符(行[j])
                j = j + 1
            追加(记号, ["错", "字符串没有结束", 行号])
            返回 n
        如果 是数字字节(c):
            j = i
            当 j < n 且 是数字字节(行[j]):
                j = j + 1
            点 = j
            如果 j < n 且 行[j] == 46 且 j + 1 < n 且 是数字字节(行[j + 1]):
                j = j + 1
                当 j < n 且 是数字字节(行[j]):
                    j = j + 1
            文本 = 行.切片(i, j)
            如果 点 < n 且 行[点] == 46:
                追加(记号, ["浮", 文本, 行号])
            否则:
                追加(记号, ["整", 文本, 行号])
            返回 j
        如果 是名字首字节(c):
            j = i
            当 j < n 且 是名字字节(行[j]):
                j = j + 1
            追加(记号, ["名", 行.切片(i, j), 行号])
            返回 j
        双 = 双字符算符(行, i)
        如果 双 == "==" 或 双 == "!=" 或 双 == "<=" 或 双 == ">=":
            追加(记号, ["符", 双, 行号])
            返回 i + 2
        # // 与 ** 必须先于 / 与 * 单独识别
        如果 双 == "//" 或 双 == "**":
            追加(记号, ["符", 双, 行号])
            返回 i + 2
        如果 简单算符(c):
            追加(记号, ["符", 字符(c), 行号])
            返回 i + 1
        追加(记号, ["错", "无法识别的字符", 行号])
        返回 i + 1
    返回 n

函数 词法(源码: 字符串) -> 列表:
    记号 = []
    缩进们 = [0]
    行号 = 0
    行们 = 分割(源码, "\n")
    行序 = 0
    当 行序 < 长度(行们):
        原始行 = 元素文本(行们, 行序)
        行号 = 行号 + 1
        无注释 = 去注释(原始行)
        干净 = 去空白(无注释)

        如果 干净 != "":
            缩进 = 前导空格(无注释)
            当前 = 元素(缩进们, 长度(缩进们) - 1)
            如果 缩进 > 当前:
                追加(缩进们, 缩进)
                追加(记号, ["增", "", 行号])
            否则:
                当 缩进 < 元素(缩进们, 长度(缩进们) - 1):
                    弹出(缩进们)
                    追加(记号, ["减", "", 行号])
            # 扫描用整行（扫描时会跳过空格），去空白只用来判断空行
            缓冲 = 无注释
            i = 0
            当 i < 长度(缓冲):
                下一步 = 扫描一行(记号, 缓冲, 行号, i)

                如果 下一步 <= i:
                    下一步 = i + 1
                i = 下一步
            追加(记号, ["行", "", 行号])
        行序 = 行序 + 1
    追加(记号, ["结", "", 行号])
    返回 记号

# ======================================================================
# 语法分析：记号 -> 抽象语法树
#   语句：["让",名,表达式] ["设",名,表达式] ["印",表达式]
#         ["如",条件,块,否则] ["当",条件,块] ["对",名,可迭代,块]
#         ["返",表达式] ["出"] ["续"] ["表",表达式] ["函",名,参数表,块]
#   表达式：["整字",文本] ["浮字",文本] ["串字",文本] ["真字"] ["假字"] ["空字"]
#           ["变",名] ["单",算符,表达式] ["双",算符,左,右] ["调",名,实参表]
#           ["索",容器,下标] ["法",接收者,方法名,实参表] ["列字",元素表]
# ======================================================================

函数 记号类型(记号: 列表, 位置: 整数) -> 字符串:
    t = 记号[位置]
    返回 元素文本(t, 0)

函数 记号值(记号: 列表, 位置: 整数) -> 字符串:
    t = 记号[位置]
    返回 元素文本(t, 1)

函数 记号是(记号: 列表, 位置: 整数, 类型: 字符串, 值: 字符串) -> 布尔:
    如果 位置 >= 长度(记号):
        返回 假
    如果 记号类型(记号, 位置) != 类型:
        返回 假
    如果 值 == "":
        返回 真
    返回 记号值(记号, 位置) == 值

函数 记号行(记号: 列表, 位置: 整数) -> 整数:
    如果 位置 >= 长度(记号):
        返回 0
    t = 记号[位置]
    返回 元素(t, 2)

函数 记号文本(记号: 列表, 位置: 整数) -> 字符串:
    如果 位置 >= 长度(记号):
        返回 ""
    返回 记号值(记号, 位置)

函数 报错(记号: 列表, 位置: 整数, 信息: 字符串) -> 整数:
    错误输出("自举编译器错误：第 " + 字符串(记号行(记号, 位置)) + " 行 " + 信息)
    错误输出("  位置=" + 字符串(位置) + " 类型[" + 记号类型(记号, 位置) + "] 值[" + 记号值(记号, 位置) + "]")
    退出(1)
    返回 0

函数 期待行(记号: 列表, 位置: 整数) -> 整数:
    如果 记号是(记号, 位置, "行", ""):
        返回 位置 + 1
    报错(记号, 位置, "期望一行结束")
    返回 0

函数 期待(记号: 列表, 位置: 整数, 值: 字符串) -> 整数:
    # 标点记成 "符"，关键字记成 "名"，两种都算匹配
    如果 记号是(记号, 位置, "符", 值) 或 记号是(记号, 位置, "名", 值):
        返回 位置 + 1
    报错(记号, 位置, "期望 " + 值 + "，实际是 " + 记号文本(记号, 位置))
    返回 位置 + 1

# ---- 表达式 ----

函数 解析表达式(记号: 列表, 位置: 整数) -> 列表:
    r = 解析与(记号, 位置)
    返回 r

函数 解析与(记号: 列表, 位置: 整数) -> 列表:
    r = 解析比较(记号, 位置)
    # 且 / 或 同级，左结合
    当 记号是(记号, r[1], "名", "且") 或 记号是(记号, r[1], "名", "或"):
        算符 = 记号文本(记号, r[1])
        右 = 解析比较(记号, r[1] + 1)
        r = [["双", 算符, r[0], 右[0]], 右[1]]
    返回 r

函数 解析比较(记号: 列表, 位置: 整数) -> 列表:
    r = 解析加减(记号, 位置)
    当 记号是(记号, r[1], "符", "==") 或 记号是(记号, r[1], "符", "!=") 或 记号是(记号, r[1], "符", "<") 或 记号是(记号, r[1], "符", ">") 或 记号是(记号, r[1], "符", "<=") 或 记号是(记号, r[1], "符", ">="):
        算符 = 记号文本(记号, r[1])
        右 = 解析加减(记号, r[1] + 1)
        r = [["双", 算符, r[0], 右[0]], 右[1]]
    返回 r

函数 是加法算符(记号: 列表, 位置: 整数) -> 布尔:
    返回 记号是(记号, 位置, "符", "+") 或 记号是(记号, 位置, "符", "-")

函数 解析加减(记号: 列表, 位置: 整数) -> 列表:
    r = 解析乘除(记号, 位置)
    当 是加法算符(记号, r[1]):
        算符 = 记号文本(记号, r[1])
        右 = 解析乘除(记号, r[1] + 1)
        r = [["双", 算符, r[0], 右[0]], 右[1]]
    返回 r

函数 是乘除算符(记号: 列表, 位置: 整数) -> 布尔:
    返回 记号是(记号, 位置, "符", "*") 或 记号是(记号, 位置, "符", "/") 或 记号是(记号, 位置, "符", "%") 或 记号是(记号, 位置, "符", "//")

函数 解析乘除(记号: 列表, 位置: 整数) -> 列表:
    r = 解析幂(记号, 位置)
    当 是乘除算符(记号, r[1]):
        算符 = 记号文本(记号, r[1])
        右 = 解析幂(记号, r[1] + 1)
        r = [["双", 算符, r[0], 右[0]], 右[1]]
    返回 r

函数 解析幂(记号: 列表, 位置: 整数) -> 列表:
    # 幂右结合：2 ** 3 ** 2 == 2 ** (3 ** 2)
    r = 解析一元(记号, 位置)
    如果 记号是(记号, r[1], "符", "**"):
        右 = 解析幂(记号, r[1] + 1)
        返回 [["双", "**", r[0], 右[0]], 右[1]]
    返回 r

函数 解析一元(记号: 列表, 位置: 整数) -> 列表:
    如果 记号是(记号, 位置, "符", "-"):
        内 = 解析一元(记号, 位置 + 1)
        返回 [["单", "-", 内[0]], 内[1]]
    如果 记号是(记号, 位置, "名", "非"):
        内 = 解析一元(记号, 位置 + 1)
        返回 [["单", "非", 内[0]], 内[1]]
    返回 解析后缀(记号, 位置)

函数 解析后缀(记号: 列表, 位置: 整数) -> 列表:
    r = 解析原子(记号, 位置)
    i = r[1]
    当 真:
        如果 记号是(记号, i, "符", "("):
            参数 = 解析实参(记号, i + 1)
            r = [["调", 元素文本(r[0], 1), 参数[0]], 吃掉右括号(记号, 参数[1])]
            i = 吃掉右括号(记号, 参数[1])
            继续
        如果 记号是(记号, i, "符", "["):
            下标 = 解析表达式(记号, i + 1)
            j = 期待(记号, 下标[1], "]")
            r = [["索", r[0], 下标[0]], j]
            i = j
            继续
        如果 记号是(记号, i, "符", "."):
            方法 = 记号文本(记号, i + 1)
            # x.方法(...)：字符串方法改写成 方法(x, ...)，其余是模块成员
            如果 字符串方法(方法) 且 元素文本(r[0], 0) == "变":
                参数 = 解析实参(记号, i + 3)
                实参 = [["变", 元素文本(r[0], 1)]]
                k = 0
                当 k < 长度(参数[0]):
                    追加(实参, 参数[0][k])
                    k = k + 1
                r = [["调", 方法, 实参], 吃掉右括号(记号, 参数[1])]
                i = 吃掉右括号(记号, 参数[1])
                继续
            如果 记号是(记号, i + 2, "符", "("):
                参数 = 解析实参(记号, i + 3)
                r = [["法", r[0], 方法, 参数[0]], 吃掉右括号(记号, 参数[1])]
                i = 吃掉右括号(记号, 参数[1])
                继续
            r = [["变", 元素文本(r[0], 1) + "." + 方法], i + 2]
            继续
        返回 r
    返回 r

函数 字符串方法(名: 字符串) -> 布尔:
    返回 名 == "长度" 或 名 == "大写" 或 名 == "小写" 或 名 == "去空白" 或 名 == "查找" 或 名 == "替换" 或 名 == "分割" 或 名 == "包含" 或 名 == "切片" 或 名 == "len" 或 名 == "upper" 或 名 == "lower" 或 名 == "strip" 或 名 == "find" 或 名 == "replace" 或 名 == "split" 或 名 == "contains" 或 名 == "slice"

函数 吃掉右括号(记号: 列表, 位置: 整数) -> 整数:
    如果 记号是(记号, 位置, "符", ")"):
        返回 位置 + 1
    返回 位置

函数 解析实参(记号: 列表, 位置: 整数) -> 列表:
    参数 = []
    如果 记号是(记号, 位置, "符", ")"):
        返回 [参数, 位置 + 1]
    i = 位置
    当 真:
        e = 解析表达式(记号, i)
        追加(参数, e[0])
        i = e[1]
        如果 记号是(记号, i, "符", ","):
            i = i + 1
            # 允许尾随逗号 f(a, b,)
            如果 记号是(记号, i, "符", ")"):
                返回 [参数, i]
            继续
        返回 [参数, i]

函数 解析原子(记号: 列表, 位置: 整数) -> 列表:
    t = 记号类型(记号, 位置)
    v = 记号值(记号, 位置)
    如果 t == "整":
        返回 [["整字", v], 位置 + 1]
    如果 t == "浮":
        返回 [["浮字", v], 位置 + 1]
    如果 t == "串":
        返回 [["串字", v], 位置 + 1]
    如果 t == "名":
        如果 v == "真":
            返回 [["真字"], 位置 + 1]
        如果 v == "假":
            返回 [["假字"], 位置 + 1]
        如果 v == "空":
            返回 [["空字"], 位置 + 1]
        返回 [["变", v], 位置 + 1]
    如果 记号是(记号, 位置, "符", "("):
        # 单个表达式是括号组，(a, b) 是元组
        内 = 解析表达式(记号, 位置 + 1)
        如果 记号是(记号, 内[1], "符", ","):
            元素表 = [内[0]]
            i = 内[1] + 1
            当 真:
                e2 = 解析表达式(记号, i)
                追加(元素表, e2[0])
                i = e2[1]
                如果 记号是(记号, i, "符", ","):
                    i = i + 1
                    继续
                跳出
            返回 [["元组", 元素表], 期待(记号, i, ")")]
        返回 [内[0], 期待(记号, 内[1], ")")]
    如果 记号是(记号, 位置, "符", "["):
        返回 解析列表(记号, 位置 + 1)
    报错(记号, 位置, "无法解析的表达式")
    返回 [["空字"], 位置 + 1]

函数 解析列表(记号: 列表, 位置: 整数) -> 列表:
    元素表 = []
    如果 记号是(记号, 位置, "符", "]"):
        返回 [["列字", 元素表], 位置 + 1]
    i = 位置
    当 真:
        e = 解析表达式(记号, i)
        追加(元素表, e[0])
        i = e[1]
        如果 记号是(记号, i, "符", ","):
            i = i + 1
            继续
        返回 [["列字", 元素表], 期待(记号, i, "]")]

# ---- 语句与块 ----

函数 解析语句(记号: 列表, 位置: 整数) -> 列表:
    t = 记号类型(记号, 位置)
    v = 记号值(记号, 位置)
    如果 t == "名":
        如果 v == "让":
            名 = 记号文本(记号, 位置 + 1)
            i = 期待(记号, 位置 + 2, "=")
            e = 解析表达式(记号, i)
            返回 [["让", 名, e[0]], 期待行(记号, e[1])]
        如果 v == "如果":
            返回 解析如果(记号, 位置 + 1)
        如果 v == "当":
            条件 = 解析表达式(记号, 位置 + 1)
            b = 解析块(记号, 期待(记号, 条件[1], ":"))
            返回 [["当", 条件[0], b[0]], b[1]]
        如果 v == "对于":
            名 = 记号文本(记号, 位置 + 1)
            i = 期待(记号, 位置 + 2, "在")
            可迭代 = 解析表达式(记号, i)
            b = 解析块(记号, 期待(记号, 可迭代[1], ":"))
            返回 [["对", 名, 可迭代[0], b[0]], b[1]]
        如果 v == "返回":
            如果 记号是(记号, 位置 + 1, "行", ""):
                返回 [["返", ""], 位置 + 2]
            e = 解析表达式(记号, 位置 + 1)
            返回 [["返", e[0]], 期待行(记号, e[1])]
        如果 v == "汇编":
            指令 = 解析表达式(记号, 位置 + 1)
            返回 [["汇", 元素文本(指令[0], 1)], 期待行(记号, 指令[1])]
        如果 v == "断言":
            条件 = 解析表达式(记号, 位置 + 1)
            j = 条件[1]
            消息 = ["串字", "断言失败"]
            如果 记号是(记号, j, "符", ","):
                消息 = 解析表达式(记号, j + 1)
                j = 消息[1]
            返回 [["断", 条件[0], 消息[0]], 期待行(记号, j)]
        如果 v == "抛出":
            e = 解析表达式(记号, 位置 + 1)
            返回 [["抛", e[0]], 期待行(记号, e[1])]
        如果 v == "尝试":
            b = 解析块(记号, 期待(记号, 位置 + 1, ":"))
            捕获名 = ""
            捕获块 = []
            最后块 = []
            j = b[1]
            如果 记号文本(记号, j) == "捕获":
                捕获名 = 记号文本(记号, j + 1)
                cb = 解析块(记号, 期待(记号, j + 2, ":"))
                捕获块 = cb[0]
                j = cb[1]
            如果 记号文本(记号, j) == "最终":
                fb = 解析块(记号, 期待(记号, j + 1, ":"))
                最后块 = fb[0]
                j = fb[1]
            返回 [["试", b[0], 捕获名, 捕获块, 最后块], j]
        如果 v == "线程":
            括号 = 记号文本(记号, 位置 + 1)
            线程号 = 括号
            i = 位置 + 2
            如果 记号是(记号, 位置 + 1, "符", "("):
                线程号 = 记号文本(记号, 位置 + 2)
                i = 期待(记号, 位置 + 3, ")")
            b = 解析块(记号, 期待(记号, i, ":"))
            返回 [["程", 线程号, b[0]], b[1]]
        如果 v == "跳出":
            返回 [["出"], 期待行(记号, 位置 + 1)]
        如果 v == "继续":
            返回 [["续"], 期待行(记号, 位置 + 1)]
        如果 v == "打印":
            # 打印(参数...) 或 打印 值
            参数 = []
            j = 位置 + 1
            如果 记号是(记号, 位置 + 1, "符", "("):
                实参 = 解析实参(记号, 位置 + 2)
                参数 = 实参[0]
                j = 实参[1]
                如果 记号是(记号, j, "符", ")"):
                    j = j + 1
            否则:
                e = 解析表达式(记号, 位置 + 1)
                参数 = [e[0]]
                j = e[1]
            返回 [["印", 参数], 期待行(记号, j)]
        如果 v == "函数":
            名 = 记号文本(记号, 位置 + 1)
            i = 期待(记号, 位置 + 2, "(")
            参数 = 解析参数表(记号, i)
            j = 参数[1]
            返回类型 = "整数"
            # 跳过可选的返回类型标注：-> 字符串
            如果 记号是(记号, j, "符", "-"):
                返回类型 = 记号文本(记号, j + 2)
                j = j + 3
            b = 解析块(记号, 期待(记号, j, ":"))
            返回 [["函", 名, 参数[0], b[0], 返回类型], b[1]]
        # 赋值：容器[下标] = 表达式
        如果 记号是(记号, 位置 + 1, "符", "["):
            下标 = 解析表达式(记号, 位置 + 2)
            j = 期待(记号, 下标[1], "]")
            k = 期待(记号, j, "=")
            e = 解析表达式(记号, k)
            返回 [["设下", v, 下标[0], e[0]], 期待行(记号, e[1])]
        # 赋值：名字 = 表达式
        如果 记号是(记号, 位置 + 1, "符", "="):
            e = 解析表达式(记号, 位置 + 2)
            返回 [["设", v, e[0]], 期待行(记号, e[1])]
    e = 解析表达式(记号, 位置)
    # 调用语句不打印返回值（追加/弹出等返回空）
    如果 元素文本(e[0], 0) == "调":
        返回 [["调用", e[0]], 期待行(记号, e[1])]
    返回 [["表", e[0]], 期待行(记号, e[1])]

函数 解析参数表(记号: 列表, 位置: 整数) -> 列表:
    参数 = []
    如果 记号是(记号, 位置, "符", ")"):
        返回 [参数, 位置 + 1]
    i = 位置
    当 真:
        名字 = 记号文本(记号, i)
        i = i + 1
        # 没写类型标注的参数按动态值处理：运行期标签决定真实类型
        类型 = "未知"
        # 跳过可选的类型标注：名字: 列表
        如果 记号是(记号, i, "符", ":"):
            类型 = 记号文本(记号, i + 1)
            i = i + 2
        追加(参数, [名字, 类型])
        如果 记号是(记号, i, "符", ","):
            i = i + 1
            继续
        返回 [参数, 期待(记号, i, ")")]

函数 解析如果(记号: 列表, 位置: 整数) -> 列表:
    条件 = 解析表达式(记号, 位置)
    i = 期待(记号, 条件[1], ":")
    b = 解析块(记号, i)
    否则语句 = []
    j = b[1]
    # 否则如果：等价于「否则分支里再放一个如果」
    如果 记号是(记号, j, "名", "否则如果"):
        子 = 解析如果(记号, j + 1)
        返回 [["如", 条件[0], b[0], [子[0]]], 子[1]]
    如果 记号是(记号, j, "名", "否则"):
        c = 解析块(记号, 期待(记号, j + 1, ":"))
        否则语句 = c[0]
        j = c[1]
    返回 [["如", 条件[0], b[0], 否则语句], j]

函数 解析块(记号: 列表, 位置: 整数) -> 列表:
    语句表 = []
    i = 期待行(记号, 位置)
    当 真:
        # 块内的缩进标记：跳过
        如果 记号是(记号, i, "增", ""):
            i = i + 1
            继续
        # 退出一层缩进：本层结束
        如果 记号是(记号, i, "减", ""):
            返回 [语句表, i + 1]
        如果 记号是(记号, i, "结", ""):
            返回 [语句表, i]
        s = 解析语句(记号, i)
        追加(语句表, s[0])
        i = s[1]

函数 解析外部(记号: 列表, 位置: 整数) -> 列表:
    # 外部 名称(参数...)  —— FFI 声明
    名 = 记号文本(记号, 位置 + 1)
    i = 期待(记号, 位置 + 2, "(")
    参数 = 解析参数表(记号, i)
    j = 参数[1]
    返回 [["外", 名, 参数[0]], 期待行(记号, j)]

函数 读模块(路径: 字符串) -> 字符串:
    # 先按 原名 找，再补 .light 后缀；都找不到就返回空串
    文本 = 读取文件(路径)
    如果 文本 != "":
        返回 文本
    返回 读取文件(路径 + ".light")

函数 收进模块(项目: 列表, 路径: 字符串, 已导入: 列表) -> 整数:
    # 把模块里的顶层项目并进当前程序；已导入过就跳过（防循环导入）
    如果 包含(已导入, 路径):
        返回 0
    追加(已导入, 路径)
    源码 = 读模块(路径)
    如果 源码 == "":
        出错("找不到模块：" + 路径)
        返回 0
    记号们 = 词法(源码)
    子 = 解析程序(记号们, 0, 已导入)
    k = 0
    当 k < 长度(子):
        追加(项目, 子[k])
        k = k + 1
    返回 0

函数 解析程序(记号: 列表, 位置: 整数, 已导入: 列表) -> 列表:
    项目 = []
    i = 位置
    当 真:
        如果 记号是(记号, i, "增", "") 或 记号是(记号, i, "减", ""):
            i = i + 1
            继续
        如果 记号是(记号, i, "结", ""):
            返回 项目
        # 外部 函数名(参数...) / 导入 "模块" / 从 "模块" 导入 a, b
        如果 记号是(记号, i, "名", "外部"):
            e = 解析外部(记号, i)
            追加(项目, e[0])
            i = e[1]
            继续
        如果 记号是(记号, i, "名", "导入"):
            路径节点 = 解析表达式(记号, i + 1)
            路径 = 元素文本(路径节点[0], 1)
            收进模块(项目, 路径, 已导入)
            i = 期待行(记号, i + 2)
            继续
        如果 记号是(记号, i, "名", "从"):
            路径节点 = 解析表达式(记号, i + 1)
            路径 = 元素文本(路径节点[0], 1)
            k = 期待(记号, i + 2, "导入")
            名称们 = []
            当 真:
                如果 记号是(记号, k, "名", ""):
                    追加(名称们, 记号文本(记号, k))
                    k = k + 1
                    如果 记号是(记号, k, "符", ","):
                        k = k + 1
                        继续
                    跳出
                跳出
            收进模块(项目, 路径, 已导入)
            i = 期待行(记号, k)
            继续
        s = 解析语句(记号, i)
        追加(项目, s[0])
        i = s[1]
    返回 项目

# ---- 语法树转储（调试用）：输入以 #dump 开头时只打印语法树 ----

函数 打印语法(容器: 列表, 下标: 整数, 缩进: 字符串) -> 整数:
    如果 下标 >= 长度(容器):
        返回 0
    节点 = 容器[下标]
    # 空列表（例如没有实参的调用）也要能打印
    如果 长度(节点) == 0:
        打印(缩进 + "()")
        返回 0
    种类 = 元素文本(节点, 0)
    如果 长度(节点) <= 2:
        行文本 = 缩进 + 种类
        如果 长度(节点) == 2:
            如果 元素标签(节点, 1) == 5:
                打印(行文本)
                表 = 节点[1]
                k = 0
                当 k < 长度(表):
                    打印语法(表, k, 缩进 + "  ")
                    k = k + 1
                返回 0
            行文本 = 行文本 + " " + 元素文本(节点, 1)
        打印(行文本)
        返回 0
    打印(缩进 + 种类)
    i = 1
    当 i < 长度(节点):
        如果 元素标签(节点, i) == 5:
            打印语法(节点, i, 缩进 + "  ")
        否则如果 元素标签(节点, i) != 2:
            打印(缩进 + "  " + 元素文本(节点, i))
        i = i + 1
    返回 0

函数 打印语法块(块: 列表, 缩进: 字符串) -> 整数:
    i = 0
    当 i < 长度(块):
        打印语法(块, i, 缩进)
        i = i + 1
    返回 0

# ======================================================================
# 入口：读源码 -> 词法 -> 语法 -> 输出
#   目前实现到「前端」：词法与语法分析，输出记号与语法树统计。
#   代码生成（LLVM IR 输出）见 docs/bootstrap.md 的后续阶段。
# ======================================================================

函数 统计(记号: 列表) -> 列表:
    名字数 = 0
    整数十 = 0
    串数十 = 0
    i = 0
    当 i < 长度(记号):
        k = 记号类型(记号, i)
        如果 k == "名":
            名字数 = 名字数 + 1
        否则如果 k == "整":
            整数十 = 整数十 + 1
        否则如果 k == "串":
            串数十 = 串数十 + 1
        i = i + 1
    返回 [名字数, 整数十, 串数十]

函数 打印记号(记号: 列表, 数量: 整数) -> 整数:
    i = 0
    n = 长度(记号)
    如果 数量 < n:
        n = 数量
    当 i < n:
        t = 记号[i]
        打印(元素文本(t, 0) + " " + 元素文本(t, 1) + " @" + 字符串(元素(t, 2)))
        i = i + 1
    返回 0

# ======================================================================
# 代码生成：语法树 -> LLVM IR
#
#   上下文 = [输出们, 临时号, 标签号, 常量号, 符号表, 变量表, 循环栈,
#             结果槽, 结束标签]
#   变量表项 = [名字, 槽位, 类型]
#   符号表项 = [名字, 符号, 返回类型, 声明, 参数数]
#
#   所有值都是 i64；字符串与列表是指针。
#   列表元素的类型编译期不可知，读取时带运行期标签（light_tagged）。
#   函数只有一个返回值：用「结果槽 + 结束标签」实现，避免 phi 节点。
# ======================================================================

函数 出错(信息: 字符串) -> 整数:
    错误输出("自举编译器错误：" + 信息)
    退出(1)
    返回 0

函数 记跳转(上下文: 列表, 目标们: 字符串) -> 整数:
    # 记录这条终结指令跳向哪些块（形如 ",then0,else1,"）
    上下文[10] = 1
    上下文[12] = 目标们
    返回 0

函数 发射(上下文: 列表, 文本: 字符串) -> 整数:
    追加(上下文[0], 文本)
    头 = 文本.切片(0, 4)
    如果 头 == "  br" 或 头 == "  ret":
        上下文[10] = 1
    否则:
        上下文[10] = 0
        上下文[12] = ""
    返回 0

函数 新寄存器(上下文: 列表) -> 字符串:
    n = 上下文[1]
    上下文[1] = n + 1
    返回 "%t" + 字符串(n)

函数 新标签(上下文: 列表, 前缀: 字符串) -> 字符串:
    n = 上下文[2]
    上下文[2] = n + 1
    返回 前缀 + 字符串(n)

函数 十六(值: 整数) -> 字符串:
    数字们 = "0123456789ABCDEF"
    返回 字符(数字们[整数(值 / 16)]) + 字符(数字们[值 % 16])

函数 转义(文本: 字符串) -> 字符串:
    出 = ""
    i = 0
    当 i < 长度(文本):
        c = 文本[i]
        如果 c == 34:
            出 = 出 + "\22"
        否则如果 c == 92:
            出 = 出 + "\5C"
        否则如果 c == 10:
            出 = 出 + "\\0A"
        否则如果 c == 9:
            出 = 出 + "\\09"
        否则如果 c >= 32 且 c <= 126:
            出 = 出 + 字符(c)
        否则:
            出 = 出 + "\\" + 十六(c)
        i = i + 1
    返回 出

函数 类型码(种类: 字符串) -> 整数:
    如果 种类 == "字符串":
        返回 2
    如果 种类 == "浮点":
        返回 1
    如果 种类 == "布尔":
        返回 3
    如果 种类 == "列表":
        返回 5
    如果 种类 == "字典":
        返回 6
    如果 种类 == "元组":
        返回 7
    返回 0

函数 查符号(上下文: 列表, 名字: 字符串) -> 列表:
    表 = 上下文[4]
    i = 0
    当 i < 长度(表):
        项 = 表[i]
        如果 元素文本(项, 0) == 名字:
            返回 [元素文本(项, 1), 元素文本(项, 2), 元素文本(项, 4), 项[5]]
        i = i + 1
    # 没找到：返回空列表（调用处会再查一次内建）
    返回 []

函数 找变量(上下文: 列表, 名字: 字符串) -> 列表:
    表 = 上下文[5]
    i = 0
    当 i < 长度(表):
        项 = 表[i]
        如果 元素文本(项, 0) == 名字:
            返回 [元素文本(项, 1), 元素文本(项, 2)]
        i = i + 1
    返回 []

函数 查变量(上下文: 列表, 名字: 字符串) -> 列表:
    表 = 上下文[5]
    i = 0
    当 i < 长度(表):
        项 = 表[i]
        如果 元素文本(项, 0) == 名字:
            返回 [元素文本(项, 1), 元素文本(项, 2)]
        i = i + 1
    出错("未定义的变量：" + 名字)
    返回 ["", "整数"]

函数 存元素(上下文: 列表, 目标数组: 字符串, 下标: 整数, 值: 列表) -> 整数:
    类型 = 元素文本(值, 1)
    原始 = 元素文本(值, 0)
    如果 类型 == "未知":
        去 = 新寄存器(上下文)
        发射(上下文, "  " + 去 + " = call i64 @light_untag(i64 " + 原始 + ")")
        标 = 新寄存器(上下文)
        发射(上下文, "  " + 标 + " = call i32 @light_tag_of(i64 " + 原始 + ")")
        发射(上下文, "  call void @light_array_set_tag(ptr " + 目标数组 + ", i64 " + 字符串(下标) + ", i32 " + 标 + ", i64 " + 去 + ")")
        返回 0
    发射(上下文, "  call void @light_array_set_tag(ptr " + 目标数组 + ", i64 " + 字符串(下标) + ", i32 " + 字符串(类型码(类型)) + ", i64 " + 原始 + ")")
    返回 0

函数 造常量(上下文: 列表, 文本: 字符串) -> 列表:
    n = 上下文[3]
    上下文[3] = n + 1
    名字 = "@.str" + 字符串(n)
    长度文本 = 字符串(长度(文本))
    追加(上下文[9], 名字 + " = private constant [" + 长度文本 + " x i8] c\"" + 转义(文本) + "\"")
    r = 新寄存器(上下文)
    发射(上下文, "  " + r + " = getelementptr [" + 长度文本 + " x i8], ptr " + 名字 + ", i64 0, i64 0")
    返回 [r, 长度文本]

函数 造字符串(上下文: 列表, 文本: 字符串) -> 字符串:
    常量 = 造常量(上下文, 文本)
    v = 新寄存器(上下文)
    发射(上下文, "  " + v + " = call ptr @light_str_from_utf8(ptr " + 元素文本(常量, 0) + ", i64 " + 元素文本(常量, 1) + ")")
    值 = 新寄存器(上下文)
    发射(上下文, "  " + 值 + " = ptrtoint ptr " + v + " to i64")
    返回 值

函数 取指针(上下文: 列表, 值: 列表) -> 字符串:
    寄存器 = 元素文本(值, 0)
    如果 元素文本(值, 1) == "未知":
        去 = 新寄存器(上下文)
        发射(上下文, "  " + 去 + " = call i64 @light_untag(i64 " + 寄存器 + ")")
        寄存器 = 去
    p = 新寄存器(上下文)
    发射(上下文, "  " + p + " = inttoptr i64 " + 寄存器 + " to ptr")
    返回 p

函数 插入入口(上下文: 列表) -> 整数:
    # 把待插入的 alloca 搬到函数入口块：LLVM 要求定义支配所有使用
    待插入 = 上下文[14]
    如果 长度(待插入) == 0:
        返回 0
    点 = 上下文[13]
    新行们 = []
    i = 0
    当 i < 点:
        追加(新行们, 上下文[0][i])
        i = i + 1
    k = 0
    当 k < 长度(待插入):
        追加(新行们, 待插入[k])
        k = k + 1
    当 i < 长度(上下文[0]):
        追加(新行们, 上下文[0][i])
        i = i + 1
    上下文[0] = 新行们
    上下文[14] = []
    返回 0

函数 开块(上下文: 列表, 标签: 字符串) -> 整数:
    闭块(上下文, 标签)
    发射(上下文, 标签 + ":")
    上下文[11] = 标签
    返回 0

函数 闭块(上下文: 列表, 标签: 字符串) -> 整数:
    # 当前块已经有终结指令时不能再补：既避免空基本块，
    # 也避免同一个块里出现两条终结指令（phi 的前驱数也要跟着对）。
    如果 上下文[10] == 1:
        返回 0
    发射(上下文, "  br label %" + 标签)
    上下文[10] = 1
    上下文[12] = "," + 标签 + ","
    返回 0

函数 带标签(上下文: 列表, 值: 列表) -> 字符串:
    种类 = 元素文本(值, 1)
    如果 种类 == "未知":
        返回 元素文本(值, 0)
    r = 新寄存器(上下文)
    发射(上下文, "  " + r + " = call i64 @light_tagged(i64 " + 元素文本(值, 0) + ", i32 " + 字符串(类型码(种类)) + ")")
    返回 r

函数 真值(上下文: 列表, 条件: 字符串) -> 字符串:
    r = 新寄存器(上下文)
    发射(上下文, "  " + r + " = icmp ne i64 " + 条件 + ", 0")
    返回 r

函数 整数转位(上下文: 列表, 指针: 字符串) -> 字符串:
    v = 新寄存器(上下文)
    发射(上下文, "  " + v + " = ptrtoint ptr " + 指针 + " to i64")
    返回 v

函数 取浮点(上下文: 列表, 值: 列表) -> 字符串:
    # 浮点以 bitcast 后的 i64 传递，取出时还原成 double
    r = 新寄存器(上下文)
    发射(上下文, "  " + r + " = bitcast i64 " + 元素文本(值, 0) + " to double")
    返回 r

函数 解标签值(上下文: 列表, 值: 列表) -> 字符串:
    # 运行期才知道类型的值可能带标签，交给被调函数前先解掉
    如果 元素文本(值, 1) == "未知":
        n = 新寄存器(上下文)
        发射(上下文, "  " + n + " = call i64 @light_untag(i64 " + 元素文本(值, 0) + ")")
        返回 n
    返回 元素文本(值, 0)

函数 符号表形参(符号: 列表) -> 列表:
    # 查符号 返回 [符号, 返回类型, 参数数, 形参类型]
    如果 长度(符号) > 3:
        返回 符号[3]
    返回 []


函数 生成实参(上下文: 列表, 实参: 列表, 形参类型) -> 字符串:
    文本 = ""
    i = 0
    当 i < 长度(实参):
        节点 = 实参[i]
        值 = 生成表达式(上下文, 节点)
        r = 元素文本(值, 0)
        原值 = r
        # 形参没写类型（动态）时，实参要带上运行期标签，形参内部才能正确分派
        如果 i < 长度(形参类型) 且 长度(形参类型[i]) > 0 且 长度(形参类型[i][0]) > 0 且 元素文本(形参类型[i][0], 0) == "未知":
            r = 带标签(上下文, 值)
        否则:
            r = 解标签值(上下文, 值)
        # 字符串变量按值传入：复制一份，被调函数负责释放。
        # r 可能已经带上标签，当指针用会取到野指针，dup 必须用未加标签的原值
        如果 元素文本(值, 1) == "字符串" 且 元素文本(节点, 0) == "变":
            p = 新寄存器(上下文)
            发射(上下文, "  " + p + " = inttoptr i64 " + 原值 + " to ptr")
            d = 新寄存器(上下文)
            发射(上下文, "  " + d + " = call ptr @light_str_dup(ptr " + p + ")")
            n = 新寄存器(上下文)
            发射(上下文, "  " + n + " = ptrtoint ptr " + d + " to i64")
            r = n
        如果 i > 0:
            文本 = 文本 + ", "
        文本 = 文本 + "i64 " + r
        i = i + 1
    返回 文本

函数 生成比较(上下文: 列表, 算符: 字符串, 左: 列表, 右: 列表) -> 列表:
    谓词 = "eq"
    如果 算符 == "==":
        谓词 = "eq"
    否则如果 算符 == "!=":
        谓词 = "ne"
    否则如果 算符 == "<":
        谓词 = "slt"
    否则如果 算符 == ">":
        谓词 = "sgt"
    否则如果 算符 == "<=":
        谓词 = "sle"
    否则:
        谓词 = "sge"
    c = 新寄存器(上下文)
    发射(上下文, "  " + c + " = icmp " + 谓词 + " i64 " + 元素文本(左, 0) + ", " + 元素文本(右, 0))
    r = 新寄存器(上下文)
    发射(上下文, "  " + r + " = zext i1 " + c + " to i64")
    返回 [r, "布尔"]

函数 生成短路(上下文: 列表, 算符: 字符串, 左节点: 列表, 右节点: 列表) -> 列表:
    左 = 生成表达式(上下文, 左节点)
    跳右 = 真值(上下文, 元素文本(左, 0))
    # 结果槽的 alloca 要放到入口块（跨基本块使用需要支配关系）
    槽 = 新寄存器(上下文)
    追加(上下文[14], "  " + 槽 + " = alloca i64")
    初值 = 新寄存器(上下文)
    如果 算符 == "或":
        发射(上下文, "  " + 初值 + " = add i64 1, 0")
    否则:
        发射(上下文, "  " + 初值 + " = add i64 0, 0")
    发射(上下文, "  store i64 " + 初值 + ", ptr " + 槽)
    右标签 = 新标签(上下文, "rhs")
    合并 = 新标签(上下文, "scend")
    如果 算符 == "且":
        发射(上下文, "  br i1 " + 跳右 + ", label %" + 右标签 + ", label %" + 合并)
    否则:
        发射(上下文, "  br i1 " + 跳右 + ", label %" + 合并 + ", label %" + 右标签)
    记跳转(上下文, "," + 右标签 + "," + 合并 + ",")
    开块(上下文, 右标签)
    右 = 生成表达式(上下文, 右节点)
    发射(上下文, "  store i64 " + 元素文本(右, 0) + ", ptr " + 槽)
    开块(上下文, 合并)
    r = 新寄存器(上下文)
    发射(上下文, "  " + r + " = load i64, ptr " + 槽)
    返回 [r, "布尔"]
函数 生成内建(上下文: 列表, 名字: 字符串, 实参: 列表) -> 列表:
    r = 新寄存器(上下文)
    # ---- 下面是一批内建函数：与 lightc 的实现一一对应 ----
    如果 名字 == "数组" 且 长度(实参) == 1:
        n = 生成表达式(上下文, 实参[0])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_array_new(i64 " + 元素文本(n, 0) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "列表"]
    如果 名字 == "字典" 且 长度(实参) == 0:
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_dict_new()")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "字典"]
    如果 名字 == "范围" 且 长度(实参) == 1:
        n = 生成表达式(上下文, 实参[0])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_range(i64 " + 元素文本(n, 0) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "列表"]
    如果 名字 == "等待全部":
        发射(上下文, "  " + r + " = call i64 @light_thread_join_all()")
        返回 [r, "整数"]
    如果 名字 == "求和" 且 长度(实参) == 1:
        序 = 生成表达式(上下文, 实参[0])
        p = 取指针(上下文, 序)
        长度寄存器 = 新寄存器(上下文)
        发射(上下文, "  " + 长度寄存器 + " = call i64 @light_array_len(ptr " + p + ")")
        零 = 新寄存器(上下文)
        发射(上下文, "  " + 零 + " = add i64 0, 0")
        # 累加器与下标都要放在入口块（跨基本块需要支配关系）
        和 = 新寄存器(上下文)
        追加(上下文[14], "  " + 和 + " = alloca i64")
        发射(上下文, "  store i64 " + 零 + ", ptr " + 和)
        k = 新寄存器(上下文)
        追加(上下文[14], "  " + k + " = alloca i64")
        发射(上下文, "  store i64 " + 零 + ", ptr " + k)
        头 = 新标签(上下文, "sumhead")
        体 = 新标签(上下文, "sumbody")
        结束 = 新标签(上下文, "sumend")
        发射(上下文, "  br label %" + 头)
        记跳转(上下文, "," + 头 + ",")
        开块(上下文, 头)
        下标 = 新寄存器(上下文)
        发射(上下文, "  " + 下标 + " = load i64, ptr " + k)
        谓词 = 新寄存器(上下文)
        发射(上下文, "  " + 谓词 + " = icmp slt i64 " + 下标 + ", " + 长度寄存器)
        发射(上下文, "  br i1 " + 谓词 + ", label %" + 体 + ", label %" + 结束)
        记跳转(上下文, "," + 体 + "," + 结束 + ",")
        开块(上下文, 体)
        元素值 = 新寄存器(上下文)
        发射(上下文, "  " + 元素值 + " = call i64 @light_array_get(ptr " + p + ", i64 " + 下标 + ")")
        当前和 = 新寄存器(上下文)
        发射(上下文, "  " + 当前和 + " = load i64, ptr " + 和)
        新和 = 新寄存器(上下文)
        发射(上下文, "  " + 新和 + " = add i64 " + 当前和 + ", " + 元素值)
        发射(上下文, "  store i64 " + 新和 + ", ptr " + 和)
        下一 = 新寄存器(上下文)
        发射(上下文, "  " + 下一 + " = add i64 " + 下标 + ", 1")
        发射(上下文, "  store i64 " + 下一 + ", ptr " + k)
        发射(上下文, "  br label %" + 头)
        记跳转(上下文, "," + 头 + ",")
        开块(上下文, 结束)
        结果 = 新寄存器(上下文)
        发射(上下文, "  " + 结果 + " = load i64, ptr " + 和)
        返回 [结果, "整数"]
    如果 (名字 == "最大" 或 名字 == "最小") 且 长度(实参) == 2:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        谓词 = "sgt"
        如果 名字 == "最小":
            谓词 = "slt"
        结果 = 新寄存器(上下文)
        如果 元素文本(a, 1) == "浮点" 或 元素文本(b, 1) == "浮点":
            da = 取浮点(上下文, a)
            db = 取浮点(上下文, b)
            cmp = 新寄存器(上下文)
            发射(上下文, "  " + cmp + " = fcmp " + 谓词 + " double " + da + ", " + db)
            发射(上下文, "  " + 结果 + " = select i1 " + cmp + ", double " + da + ", double " + db)
            位 = 新寄存器(上下文)
            发射(上下文, "  " + 位 + " = bitcast double " + 结果 + " to i64")
            返回 [位, "浮点"]
        cmp2 = 新寄存器(上下文)
        发射(上下文, "  " + cmp2 + " = icmp " + 谓词 + " i64 " + 元素文本(a, 0) + ", " + 元素文本(b, 0))
        发射(上下文, "  " + 结果 + " = select i1 " + cmp2 + ", i64 " + 元素文本(a, 0) + ", i64 " + 元素文本(b, 0))
        返回 [结果, 元素文本(a, 1)]
    如果 名字 == "绝对值" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        如果 元素文本(a, 1) == "浮点":
            da = 取浮点(上下文, a)
            m = 新寄存器(上下文)
            发射(上下文, "  " + m + " = fcmp olt double " + da + ", 0.0")
            负 = 新寄存器(上下文)
            发射(上下文, "  " + 负 + " = fsub double 0.0, " + da)
            res = 新寄存器(上下文)
            发射(上下文, "  " + res + " = select i1 " + m + ", double " + 负 + ", double " + da)
            位 = 新寄存器(上下文)
            发射(上下文, "  " + 位 + " = bitcast double " + res + " to i64")
            返回 [位, "浮点"]
        m2 = 新寄存器(上下文)
        发射(上下文, "  " + m2 + " = icmp slt i64 " + 元素文本(a, 0) + ", 0")
        负2 = 新寄存器(上下文)
        发射(上下文, "  " + 负2 + " = sub i64 0, " + 元素文本(a, 0))
        res2 = 新寄存器(上下文)
        发射(上下文, "  " + res2 + " = select i1 " + m2 + ", i64 " + 负2 + ", i64 " + 元素文本(a, 0))
        返回 [res2, "整数"]
    如果 名字 == "平方根" 且 长度(实参) == 1:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_sqrt(double " + a + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "正弦" 且 长度(实参) == 1:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_sin(double " + a + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "正切" 且 长度(实参) == 1:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_tan(double " + a + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "余弦" 且 长度(实参) == 1:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_cos(double " + a + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "对数" 且 长度(实参) == 1:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_log(double " + a + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "对数10" 且 长度(实参) == 1:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_log10(double " + a + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "幂" 且 长度(实参) == 2:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        b = 取浮点(上下文, 生成表达式(上下文, 实参[1]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_pow(double " + a + ", double " + b + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "向下取整" 且 长度(实参) == 1:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_floor(double " + a + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "向上取整" 且 长度(实参) == 1:
        a = 取浮点(上下文, 生成表达式(上下文, 实参[0]))
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_ceil(double " + a + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "圆周率":
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_pi()")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "自然常数":
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_e()")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "随机":
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_math_random()")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "随机整数" 且 长度(实参) == 2:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call i64 @light_math_random_int(i64 " + 元素文本(a, 0) + ", i64 " + 元素文本(b, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "小写" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_str_lower(ptr " + 取指针(上下文, a) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "大写" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_str_upper(ptr " + 取指针(上下文, a) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "去空白" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_str_trim(ptr " + 取指针(上下文, a) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "替换" 且 长度(实参) == 3:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        c = 生成表达式(上下文, 实参[2])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_str_replace(ptr " + 取指针(上下文, a) + ", ptr " + 取指针(上下文, b) + ", ptr " + 取指针(上下文, c) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "查找" 且 长度(实参) == 2:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call i64 @light_str_find(ptr " + 取指针(上下文, a) + ", ptr " + 取指针(上下文, b) + ")")
        返回 [r, "整数"]
    如果 名字 == "读取文件" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_file_read(ptr " + 取指针(上下文, a) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "字符串"]
    如果 (名字 == "写入文件" 或 名字 == "追加文件") 且 长度(实参) == 2:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        调用 = "light_file_write"
        如果 名字 == "追加文件":
            调用 = "light_file_append"
        发射(上下文, "  " + r + " = call i1 @" + 调用 + "(ptr " + 取指针(上下文, a) + ", ptr " + 取指针(上下文, b) + ")")
        返回 [r, "布尔"]
    如果 名字 == "文件存在" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        发射(上下文, "  " + r + " = call i1 @light_file_exists(ptr " + 取指针(上下文, a) + ")")
        返回 [r, "布尔"]
    如果 名字 == "环境变量" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_sys_getenv(ptr " + 取指针(上下文, a) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "执行" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_sys_exec(ptr " + 取指针(上下文, a) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "布尔" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        条件 = 真值(上下文, 元素文本(a, 0))
        发射(上下文, "  " + r + " = zext i1 " + 条件 + " to i64")
        返回 [r, "布尔"]
    如果 名字 == "浮点" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        如果 元素文本(a, 1) == "浮点":
            返回 [元素文本(a, 0), "浮点"]
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_str_to_float(ptr " + 取指针(上下文, a) + ")")
        位 = 新寄存器(上下文)
        发射(上下文, "  " + 位 + " = bitcast double " + d + " to i64")
        返回 [位, "浮点"]
    如果 名字 == "索引" 且 长度(实参) == 2:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call i64 @light_array_index(ptr " + 取指针(上下文, a) + ", i64 " + 元素文本(b, 0) + ")")
        返回 [r, "整数"]
    # ---- 机器层：裸内存原语（用 Light 写运行时的地基，与 lightc 对应）----
    如果 名字 == "命令行参数":
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = call ptr @light_argv()")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + p + " to i64")
        返回 [v, "列表"]
    如果 名字 == "内存分配" 且 长度(实参) == 1:
        n = 生成表达式(上下文, 实参[0])
        发射(上下文, "  " + r + " = call i64 @light_mem_alloc(i64 " + 元素文本(n, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "内存释放" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        发射(上下文, "  " + r + " = call i64 @light_mem_free(i64 " + 元素文本(a, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "内存复制" 且 长度(实参) == 3:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        c = 生成表达式(上下文, 实参[2])
        发射(上下文, "  " + r + " = call i64 @light_mem_copy(i64 " + 元素文本(a, 0) + ", i64 " + 元素文本(b, 0) + ", i64 " + 元素文本(c, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "内存置零" 且 长度(实参) == 2:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call i64 @light_mem_zero(i64 " + 元素文本(a, 0) + ", i64 " + 元素文本(b, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "内存整数" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        发射(上下文, "  " + r + " = call i64 @light_mem_load(i64 " + 元素文本(a, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "存内存整数" 且 长度(实参) == 2:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call i64 @light_mem_store(i64 " + 元素文本(a, 0) + ", i64 " + 元素文本(b, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "内存字节" 且 长度(实参) == 1:
        a = 生成表达式(上下文, 实参[0])
        发射(上下文, "  " + r + " = call i64 @light_mem_load8(i64 " + 元素文本(a, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "存内存字节" 且 长度(实参) == 2:
        a = 生成表达式(上下文, 实参[0])
        b = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call i64 @light_mem_store8(i64 " + 元素文本(a, 0) + ", i64 " + 元素文本(b, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "切片" 且 长度(实参) == 3:
        串 = 生成表达式(上下文, 实参[0])
        起点 = 生成表达式(上下文, 实参[1])
        终点 = 生成表达式(上下文, 实参[2])
        c = 新寄存器(上下文)
        发射(上下文, "  " + c + " = call ptr @light_str_substr(ptr " + 取指针(上下文, 串) + ", i64 " + 元素文本(起点, 0) + ", i64 " + 元素文本(终点, 0) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "输入":
        c = 新寄存器(上下文)
        发射(上下文, "  " + c + " = call ptr @light_input()")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "错误输出" 且 长度(实参) == 1:
        文本值 = 生成表达式(上下文, 实参[0])
        sp = 取指针(上下文, 文本值)
        数据 = 新寄存器(上下文)
        发射(上下文, "  " + 数据 + " = call ptr @light_str_ptr(ptr " + sp + ")")
        n = 新寄存器(上下文)
        发射(上下文, "  " + n + " = call i64 @light_str_len(ptr " + sp + ")")
        发射(上下文, "  call void @light_eprint_str(ptr " + 数据 + ", i64 " + n + ")")
        发射(上下文, "  " + r + " = add i64 0, 0")
        返回 [r, "整数"]
    如果 名字 == "合并" 且 长度(实参) == 2:
        数组值 = 生成表达式(上下文, 实参[0])
        分隔 = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call ptr @light_str_join(ptr " + 取指针(上下文, 数组值) + ", ptr " + 取指针(上下文, 分隔) + ")")
        ri = 新寄存器(上下文)
        发射(上下文, "  " + ri + " = ptrtoint ptr " + r + " to i64")
        返回 [ri, "字符串"]
    如果 名字 == "长度" 且 长度(实参) == 1:
        值 = 生成表达式(上下文, 实参[0])
        种类 = 元素文本(值, 1)
        如果 种类 == "字符串":
            发射(上下文, "  " + r + " = call i64 @light_str_len(ptr " + 取指针(上下文, 值) + ")")
            返回 [r, "整数"]
        如果 种类 == "未知":
            发射(上下文, "  " + r + " = call i64 @light_dynamic_len(i64 " + 元素文本(值, 0) + ")")
            返回 [r, "整数"]
        发射(上下文, "  " + r + " = call i64 @light_array_len(ptr " + 取指针(上下文, 值) + ")")
        返回 [r, "整数"]
    如果 名字 == "追加" 且 长度(实参) == 2:
        容器 = 生成表达式(上下文, 实参[0])
        值 = 生成表达式(上下文, 实参[1])
        指针 = 取指针(上下文, 容器)
        如果 元素文本(值, 1) == "未知":
            # 类型运行期才知道：标签随值走
            去 = 新寄存器(上下文)
            发射(上下文, "  " + 去 + " = call i64 @light_untag(i64 " + 元素文本(值, 0) + ")")
            标 = 新寄存器(上下文)
            发射(上下文, "  " + 标 + " = call i32 @light_tag_of(i64 " + 元素文本(值, 0) + ")")
            发射(上下文, "  call void @light_array_push_tag(ptr " + 指针 + ", i32 " + 标 + ", i64 " + 去 + ")")
            返回 [r, "空"]
        标2 = 新寄存器(上下文)
        发射(上下文, "  " + 标2 + " = add i32 " + 字符串(类型码(元素文本(值, 1))) + ", 0")
        发射(上下文, "  call void @light_array_push_tag(ptr " + 指针 + ", i32 " + 标2 + ", i64 " + 元素文本(值, 0) + ")")
        返回 [r, "空"]
    如果 名字 == "弹出" 且 长度(实参) == 1:
        容器 = 生成表达式(上下文, 实参[0])
        发射(上下文, "  " + r + " = call i64 @light_array_pop(ptr " + 取指针(上下文, 容器) + ")")
        返回 [r, "未知"]
    如果 名字 == "元素文本" 且 长度(实参) == 2:
        容器 = 生成表达式(上下文, 实参[0])
        下标 = 生成表达式(上下文, 实参[1])
        c = 新寄存器(上下文)
        发射(上下文, "  " + c + " = call ptr @light_array_get_text(ptr " + 取指针(上下文, 容器) + ", i64 " + 元素文本(下标, 0) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "元素" 且 长度(实参) == 2:
        容器 = 生成表达式(上下文, 实参[0])
        下标 = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call i64 @light_array_get_raw(ptr " + 取指针(上下文, 容器) + ", i64 " + 元素文本(下标, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "元素标签" 且 长度(实参) == 2:
        容器 = 生成表达式(上下文, 实参[0])
        下标 = 生成表达式(上下文, 实参[1])
        发射(上下文, "  " + r + " = call i64 @light_array_tag_at(ptr " + 取指针(上下文, 容器) + ", i64 " + 元素文本(下标, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "字符" 且 长度(实参) == 1:
        值 = 生成表达式(上下文, 实参[0])
        c = 新寄存器(上下文)
        发射(上下文, "  " + c + " = call ptr @light_byte_to_char(i64 " + 元素文本(值, 0) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "字符串" 且 长度(实参) == 1:
        值 = 生成表达式(上下文, 实参[0])
        种类 = 元素文本(值, 1)
        如果 种类 == "字符串":
            返回 值
        如果 种类 == "布尔":
            b = 新寄存器(上下文)
            发射(上下文, "  " + b + " = call ptr @light_bool_to_str(i64 " + 元素文本(值, 0) + ")")
            v2 = 新寄存器(上下文)
            发射(上下文, "  " + v2 + " = ptrtoint ptr " + b + " to i64")
            返回 [v2, "字符串"]
        如果 种类 == "浮点":
            d2 = 新寄存器(上下文)
            发射(上下文, "  " + d2 + " = bitcast i64 " + 元素文本(值, 0) + " to double")
            fp = 新寄存器(上下文)
            发射(上下文, "  " + fp + " = call ptr @light_float_to_str(double " + d2 + ")")
            v3 = 新寄存器(上下文)
            发射(上下文, "  " + v3 + " = ptrtoint ptr " + fp + " to i64")
            返回 [v3, "字符串"]
        如果 种类 == "未知":
            去 = 新寄存器(上下文)
            发射(上下文, "  " + 去 + " = call i64 @light_untag(i64 " + 元素文本(值, 0) + ")")
            标 = 新寄存器(上下文)
            发射(上下文, "  " + 标 + " = call i32 @light_tag_of(i64 " + 元素文本(值, 0) + ")")
            c = 新寄存器(上下文)
            发射(上下文, "  " + c + " = call ptr @light_dynamic_to_text(i64 " + 去 + ", i32 " + 标 + ")")
            v = 新寄存器(上下文)
            发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
            返回 [v, "字符串"]
        c = 新寄存器(上下文)
        发射(上下文, "  " + c + " = call ptr @light_int_to_str(i64 " + 元素文本(值, 0) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "去空白" 且 长度(实参) == 1:
        值 = 生成表达式(上下文, 实参[0])
        c = 新寄存器(上下文)
        发射(上下文, "  " + c + " = call ptr @light_str_trim(ptr " + 取指针(上下文, 值) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
        返回 [v, "字符串"]
    如果 名字 == "分割" 且 长度(实参) == 2:
        串 = 生成表达式(上下文, 实参[0])
        隔 = 生成表达式(上下文, 实参[1])
        c = 新寄存器(上下文)
        发射(上下文, "  " + c + " = call ptr @light_str_split(ptr " + 取指针(上下文, 串) + ", ptr " + 取指针(上下文, 隔) + ")")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
        返回 [v, "列表"]
    如果 名字 == "包含" 且 长度(实参) == 2:
        主值 = 生成表达式(上下文, 实参[0])
        子值 = 生成表达式(上下文, 实参[1])
        主类 = 元素文本(主值, 1)
        c2 = 新寄存器(上下文)
        v2 = 新寄存器(上下文)
        如果 主类 == "字符串":
            f = 新寄存器(上下文)
            发射(上下文, "  " + f + " = call i64 @light_str_find(ptr " + 取指针(上下文, 主值) + ", ptr " + 取指针(上下文, 子值) + ")")
            发射(上下文, "  " + c2 + " = icmp sge i64 " + f + ", 0")
            发射(上下文, "  " + v2 + " = zext i1 " + c2 + " to i64")
            返回 [v2, "布尔"]
        如果 主类 == "未知":
            发射(上下文, "  " + v2 + " = call i64 @light_dynamic_contains(i64 " + 元素文本(主值, 0) + ", i64 " + 元素文本(子值, 0) + ")")
            返回 [v2, "布尔"]
        发射(上下文, "  " + v2 + " = call i64 @light_array_contains(ptr " + 取指针(上下文, 主值) + ", i64 " + 元素文本(子值, 0) + ")")
        返回 [v2, "布尔"]
    如果 名字 == "整数" 且 长度(实参) == 1:
        值 = 生成表达式(上下文, 实参[0])
        种类 = 元素文本(值, 1)
        如果 种类 == "浮点":
            d = 新寄存器(上下文)
            发射(上下文, "  " + d + " = bitcast i64 " + 元素文本(值, 0) + " to double")
            f = 新寄存器(上下文)
            v = 新寄存器(上下文)
            发射(上下文, "  " + v + " = fptosi double " + d + " to i64")
            返回 [v, "整数"]
        返回 值
    如果 名字 == "退出" 且 长度(实参) == 1:
        值 = 生成表达式(上下文, 实参[0])
        发射(上下文, "  call void @light_sys_exit(i64 " + 元素文本(值, 0) + ")")
        返回 [r, "整数"]
    如果 名字 == "读入":
        c = 新寄存器(上下文)
        发射(上下文, "  " + c + " = call ptr @light_read_all_stdin()")
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
        返回 [v, "字符串"]
    返回 []

函数 生成表达式(上下文: 列表, 表达式: 列表) -> 列表:
    种类 = 元素文本(表达式, 0)
    r = 新寄存器(上下文)
    # 另用一个寄存器预定义一个 0：某些分支会换用别的寄存器返回，
    # 先保证这里不会生成悬空引用（LLVM 的临时值在同一块里不能重名）
    备用 = 新寄存器(上下文)
    发射(上下文, "  " + 备用 + " = add i64 0, 0")
    如果 种类 == "整字":
        发射(上下文, "  " + r + " = add i64 0, " + 元素文本(表达式, 1))
        返回 [r, "整数"]
    如果 种类 == "串字":
        v = 造字符串(上下文, 元素文本(表达式, 1))
        返回 [v, "字符串"]
    如果 种类 == "真字":
        发射(上下文, "  " + r + " = add i64 0, 1")
        返回 [r, "布尔"]
    如果 种类 == "假字":
        发射(上下文, "  " + r + " = add i64 0, 0")
        返回 [r, "布尔"]
    如果 种类 == "空字":
        发射(上下文, "  " + r + " = add i64 0, 0")
        返回 [r, "空"]
    如果 种类 == "浮字":
        v = 造字符串(上下文, 元素文本(表达式, 1))
        p = 新寄存器(上下文)
        发射(上下文, "  " + p + " = inttoptr i64 " + v + " to ptr")
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = call double @light_str_to_float(ptr " + p + ")")
        发射(上下文, "  " + r + " = bitcast double " + d + " to i64")
        返回 [r, "浮点"]
    如果 种类 == "变":
        找到 = 查变量(上下文, 元素文本(表达式, 1))
        发射(上下文, "  " + r + " = load i64, ptr " + 元素文本(找到, 0))
        返回 [r, 元素文本(找到, 1)]
    如果 种类 == "单":
        算符 = 元素文本(表达式, 1)
        值 = 生成表达式(上下文, 表达式[2])
        如果 算符 == "非":
            发射(上下文, "  " + r + " = xor i64 " + 元素文本(值, 0) + ", 1")
            返回 [r, "布尔"]
        零 = 新寄存器(上下文)
        发射(上下文, "  " + 零 + " = add i64 0, 0")
        发射(上下文, "  " + r + " = sub i64 " + 零 + ", " + 元素文本(值, 0))
        返回 [r, "整数"]
    如果 种类 == "双":
        算符 = 元素文本(表达式, 1)
        如果 算符 == "且" 或 算符 == "或":
            返回 生成短路(上下文, 算符, 表达式[2], 表达式[3])
        左 = 生成表达式(上下文, 表达式[2])
        右 = 生成表达式(上下文, 表达式[3])
        左类 = 元素文本(左, 1)
        右类 = 元素文本(右, 1)
        是比较 = 算符 == "==" 或 算符 == "!=" 或 算符 == "<" 或 算符 == ">" 或 算符 == "<=" 或 算符 == ">="
        # 除法（/）在 Light 里恒为浮点：整数整除用 //
        如果 算符 == "/" 或 左类 == "浮点" 或 右类 == "浮点":
            lf = 取浮点(上下文, 左)
            rf = 取浮点(上下文, 右)
            如果 是比较:
                浮谓词 = "oeq"
                如果 算符 == "!=":
                    浮谓词 = "one"
                否则如果 算符 == "<":
                    浮谓词 = "olt"
                否则如果 算符 == ">":
                    浮谓词 = "ogt"
                否则如果 算符 == "<=":
                    浮谓词 = "ole"
                否则如果 算符 == ">=":
                    浮谓词 = "oge"
                浮cmp = 新寄存器(上下文)
                发射(上下文, "  " + 浮cmp + " = fcmp " + 浮谓词 + " double " + lf + ", " + rf)
                零c = 新寄存器(上下文)
                发射(上下文, "  " + 零c + " = add i64 0, 0")
                返回 生成比较(上下文, 算符, [浮cmp, "整数"], [零c, "整数"])
            浮结果 = 新寄存器(上下文)
            如果 算符 == "**":
                发射(上下文, "  " + 浮结果 + " = call double @llvm.pow.f64(double " + lf + ", double " + rf + ")")
            否则如果 算符 == "//":
                商 = 新寄存器(上下文)
                发射(上下文, "  " + 商 + " = fdiv double " + lf + ", " + rf)
                发射(上下文, "  " + 浮结果 + " = call double @llvm.floor.f64(double " + 商 + ")")
            否则:
                浮指令 = "fadd"
                如果 算符 == "-":
                    浮指令 = "fsub"
                否则如果 算符 == "*":
                    浮指令 = "fmul"
                否则如果 算符 == "/":
                    浮指令 = "fdiv"
                否则如果 算符 == "%":
                    浮指令 = "frem"
                发射(上下文, "  " + 浮结果 + " = " + 浮指令 + " double " + lf + ", " + rf)
            位 = 新寄存器(上下文)
            发射(上下文, "  " + 位 + " = bitcast double " + 浮结果 + " to i64")
            返回 [位, "浮点"]
        如果 是比较:
            如果 左类 == "字符串" 或 右类 == "字符串":
                lp = 取指针(上下文, 左)
                rp = 取指针(上下文, 右)
                cmp = 新寄存器(上下文)
                发射(上下文, "  " + cmp + " = call i64 @light_str_cmp(ptr " + lp + ", ptr " + rp + ")")
                # light_str_cmp 返回 0 / 正数 / 负数，与 0 比较
                零 = 新寄存器(上下文)
                发射(上下文, "  " + 零 + " = add i64 0, 0")
                返回 生成比较(上下文, 算符, [cmp, "整数"], [零, "整数"])
            # 动态值带运行期标签，比较前先解标签，否则永远不相等
            左比 = [解标签值(上下文, 左), 左类]
            右比 = [解标签值(上下文, 右), 右类]
            返回 生成比较(上下文, 算符, 左比, 右比)
        如果 算符 == "+" 且 (左类 == "字符串" 或 右类 == "字符串"):
            lp = 取指针(上下文, 左)
            rp = 取指针(上下文, 右)
            c = 新寄存器(上下文)
            发射(上下文, "  " + c + " = call ptr @light_str_concat(ptr " + lp + ", ptr " + rp + ")")
            v = 新寄存器(上下文)
            发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
            返回 [v, "字符串"]
        指令 = "add"
        如果 算符 == "-":
            指令 = "sub"
        否则如果 算符 == "*":
            指令 = "mul"
        否则如果 算符 == "//" 或 算符 == "**":
            # 整数整除/整幂交给运行时，保留向下取整语义
            调用 = "light_floor_div"
            如果 算符 == "**":
                调用 = "light_pow_int"
            发射(上下文, "  " + r + " = call i64 @" + 调用 + "(i64 " + 元素文本(左, 0) + ", i64 " + 元素文本(右, 0) + ")")
            返回 [r, "整数"]
        否则如果 算符 == "%":
            指令 = "srem"
        发射(上下文, "  " + r + " = " + 指令 + " i64 " + 元素文本(左, 0) + ", " + 元素文本(右, 0))
        返回 [r, "整数"]
    如果 种类 == "元组":
        # 元组用带标签的数组表示，类型码 7
        表 = 表达式[1]
        n = 长度(表)
        arr = 新寄存器(上下文)
        发射(上下文, "  " + arr + " = call ptr @light_array_new(i64 " + 字符串(n) + ")")
        i = 0
        当 i < n:
            值 = 生成表达式(上下文, 表[i])
            存元素(上下文, arr, i, 值)
            i = i + 1
        tv = 新寄存器(上下文)
        发射(上下文, "  " + tv + " = call i64 @light_tagged(i64 " + 整数转位(上下文, arr) + ", i32 7)")
        返回 [tv, "元组"]
    如果 种类 == "列字":
        表 = 表达式[1]
        n = 长度(表)
        arr = 新寄存器(上下文)
        发射(上下文, "  " + arr + " = call ptr @light_array_new(i64 " + 字符串(n) + ")")
        i = 0
        当 i < n:
            值 = 生成表达式(上下文, 表[i])
            存元素(上下文, arr, i, 值)
            i = i + 1
        v = 新寄存器(上下文)
        发射(上下文, "  " + v + " = ptrtoint ptr " + arr + " to i64")
        返回 [v, "列表"]
    如果 种类 == "索":
        容器 = 生成表达式(上下文, 表达式[1])
        下标 = 生成表达式(上下文, 表达式[2])
        # 动态值本身已带标签，直接传；已知类型的容器才补标签
        容器值 = 元素文本(容器, 0)
        如果 元素文本(容器, 1) != "未知":
            容器值 = 带标签(上下文, 容器)
        发射(上下文, "  " + r + " = call i64 @light_dynamic_get(i64 " + 容器值 + ", i64 " + 元素文本(下标, 0) + ")")
        返回 [r, "未知"]
    如果 种类 == "调":
        名字 = 元素文本(表达式, 1)
        # 用户自己定义的函数优先于同名内建
        符号 = 查符号(上下文, 名字)
        如果 长度(符号) == 0:
            内建 = 生成内建(上下文, 名字, 表达式[2])
            如果 长度(内建) > 0:
                返回 内建
            出错("未定义的函数：" + 名字)
        # 符号表里存的是文本，比较时两边都转成字符串（整数不做隐式转换）
        形参数 = 元素文本(符号, 2)
        实参数 = 字符串(长度(表达式[2]))
        如果 实参数 != 形参数:
            打印("错误: 调用 " + 名字 + " 给了 " + 实参数 + " 个参数，需要 " + 形参数 + " 个")
            退出(1)
        参数 = 生成实参(上下文, 表达式[2], 符号表形参(符号))
        发射(上下文, "  " + r + " = call i64 @" + 元素文本(符号, 0) + "(" + 参数 + ")")
        返回 [r, 元素文本(符号, 1)]
    如果 种类 == "法":
        接收者 = 生成表达式(上下文, 表达式[1])
        方法 = 元素文本(表达式, 2)
        实参 = 表达式[3]
        如果 方法 == "切片":
            起点 = 生成表达式(上下文, 实参[0])
            终点 = 生成表达式(上下文, 实参[1])
            p = 取指针(上下文, 接收者)
            c = 新寄存器(上下文)
            发射(上下文, "  " + c + " = call ptr @light_str_substr(ptr " + p + ", i64 " + 元素文本(起点, 0) + ", i64 " + 元素文本(终点, 0) + ")")
            v = 新寄存器(上下文)
            发射(上下文, "  " + v + " = ptrtoint ptr " + c + " to i64")
            返回 [v, "字符串"]
        出错("自举编译器暂不支持方法：" + 方法)
        返回 [r, "整数"]
    出错("无法生成的表达式：" + 种类)
    返回 [r, "整数"]

函数 生成打印(上下文: 列表, 实参: 列表) -> 整数:
    n = 长度(实参)
    如果 n == 0:
        发射(上下文, "  call void @light_print_newline()")
        返回 0
    如果 n == 1:
        值 = 生成表达式(上下文, 实参[0])
        生成打印一个(上下文, 值)
        返回 0
    # 多个参数：第一个是格式串，其余按位置填充
    首 = 实参[0]
    首是字面量 = 元素文本(首, 0) == "串字"
    # 第一个参数不是字符串时，按元组形式输出（与参考实现一致）
    首值 = 生成表达式(上下文, 首)
    如果 元素文本(首值, 1) != "字符串":
        表指针 = 新寄存器(上下文)
        发射(上下文, "  " + 表指针 + " = call ptr @light_array_new(i64 " + 字符串(n) + ")")
        k2 = 0
        当 k2 < n:
            值2 = 生成表达式(上下文, 实参[k2])
            存元素(上下文, 表指针, k2, 值2)
            k2 = k2 + 1
        元组 = 新寄存器(上下文)
        发射(上下文, "  " + 元组 + " = ptrtoint ptr " + 表指针 + " to i64")
        返回 生成打印一个(上下文, [元组, "元组"])
    指针 = ""
    长度寄存器 = ""
    # 格式串里没有占位符时，把后续参数按空格追加
    格式文本 = ""
    如果 首是字面量:
        格式文本 = 元素文本(首, 1)
        有占位 = 包含(格式文本, "{")
        如果 有占位 == 假:
            k = 1
            当 k < n:
                格式文本 = 格式文本 + " {}"
                k = k + 1
        常量 = 造常量(上下文, 格式文本)
        指针 = 元素文本(常量, 0)
        长度寄存器 = 新寄存器(上下文)
        发射(上下文, "  " + 长度寄存器 + " = add i64 " + 元素文本(常量, 1) + ", 0")
    否则:
        # 运行期算出的格式串：取它的字节内容（light_format_v1 要的是原始字节指针）
        # 首值上面已经求值过，直接复用：重复求值会把字面量生成两份
        结构 = 取指针(上下文, 首值)
        指针 = 新寄存器(上下文)
        发射(上下文, "  " + 指针 + " = call ptr @light_str_ptr(ptr " + 结构 + ")")
        长度寄存器 = 新寄存器(上下文)
        发射(上下文, "  " + 长度寄存器 + " = call i64 @light_str_len(ptr " + 结构 + ")")
    列表指针 = 新寄存器(上下文)
    发射(上下文, "  " + 列表指针 + " = call ptr @light_array_new(i64 " + 字符串(n - 1) + ")")
    i = 1
    当 i < n:
        值 = 生成表达式(上下文, 实参[i])
        存元素(上下文, 列表指针, i - 1, 值)
        i = i + 1
    结果 = 新寄存器(上下文)
    发射(上下文, "  " + 结果 + " = call ptr @light_format_v1(ptr " + 指针 + ", i64 " + 长度寄存器 + ", ptr null, i64 0, ptr " + 列表指针 + ", i64 0)")
    打印字符串值(上下文, 结果)
    发射(上下文, "  call void @light_print_newline()")
    发射(上下文, "  call void @light_array_free_shallow(ptr " + 列表指针 + ")")
    返回 0

函数 生成打印一个(上下文: 列表, 值: 列表) -> 整数:
    类型 = 元素文本(值, 1)
    寄存器 = 元素文本(值, 0)
    如果 类型 == "整数":
        发射(上下文, "  call void @light_print_int(i64 " + 寄存器 + ")")
    否则如果 类型 == "浮点":
        d = 新寄存器(上下文)
        发射(上下文, "  " + d + " = bitcast i64 " + 寄存器 + " to double")
        发射(上下文, "  call void @light_print_float(double " + d + ")")
    否则如果 类型 == "布尔":
        发射(上下文, "  call void @light_print_bool(i64 " + 寄存器 + ")")
    否则如果 类型 == "列表":
        p = 取指针(上下文, 值)
        发射(上下文, "  call void @light_print_array(ptr " + p + ")")
    否则如果 类型 == "元组":
        p = 取指针(上下文, 值)
        发射(上下文, "  call void @light_print_tuple(ptr " + p + ")")
    否则如果 类型 == "字典":
        p = 取指针(上下文, 值)
        发射(上下文, "  call void @light_print_dict(ptr " + p + ")")
    否则如果 类型 == "空":
        # 空没有堆结构，直接打印字面量（否则会把整数 0 当字符串指针用）
        常量 = 造常量(上下文, "空")
        串 = 新寄存器(上下文)
        发射(上下文, "  " + 串 + " = call ptr @light_str_from_utf8(ptr " + 元素文本(常量, 0) + ", i64 " + 元素文本(常量, 1) + ")")
        打印字符串值(上下文, 串)
    否则如果 类型 == "未知":
        # 运行期才知道类型：按标签打印
        去 = 新寄存器(上下文)
        发射(上下文, "  " + 去 + " = call i64 @light_untag(i64 " + 寄存器 + ")")
        标 = 新寄存器(上下文)
        发射(上下文, "  " + 标 + " = call i32 @light_tag_of(i64 " + 寄存器 + ")")
        发射(上下文, "  call void @light_print_value(i64 " + 去 + ", i32 " + 标 + ")")
    否则:
        p = 取指针(上下文, 值)
        打印字符串值(上下文, p)
    发射(上下文, "  call void @light_print_newline()")
    返回 0

函数 打印字符串值(上下文: 列表, 指针: 字符串) -> 整数:
    q = 新寄存器(上下文)
    发射(上下文, "  " + q + " = call ptr @light_str_ptr(ptr " + 指针 + ")")
    n = 新寄存器(上下文)
    发射(上下文, "  " + n + " = call i64 @light_str_len(ptr " + 指针 + ")")
    发射(上下文, "  call void @light_print_str(ptr " + q + ", i64 " + n + ")")
    返回 0

函数 生成语句(上下文: 列表, 语句: 列表) -> 整数:
    种类 = 元素文本(语句, 0)
    # 外部/导入 是顶层项目，不产生指令
    如果 种类 == "外" 或 种类 == "导" 或 种类 == "导名" 或 种类 == "函":
        返回 0
    如果 种类 == "让" 或 种类 == "设":
        值 = 生成表达式(上下文, 语句[2])
        找到 = 找变量(上下文, 元素文本(语句, 1))
        如果 长度(找到) > 0:
            发射(上下文, "  store i64 " + 元素文本(值, 0) + ", ptr " + 元素文本(找到, 0))
            返回 0
        槽 = 新寄存器(上下文)
        # 槽位的 alloca 放到函数入口块：变量可能跨基本块使用
        追加(上下文[14], "  " + 槽 + " = alloca i64")
        发射(上下文, "  store i64 " + 元素文本(值, 0) + ", ptr " + 槽)
        追加(上下文[5], [元素文本(语句, 1), 槽, 元素文本(值, 1)])
        返回 0
    如果 种类 == "设下":
        找到 = 查变量(上下文, 元素文本(语句, 1))
        下标 = 生成表达式(上下文, 语句[2])
        值 = 生成表达式(上下文, 语句[3])
        加载 = 新寄存器(上下文)
        发射(上下文, "  " + 加载 + " = load i64, ptr " + 元素文本(找到, 0))
        # 容器可能是带标签的动态值，取指针时会解标签
        目标 = 取指针(上下文, [加载, 元素文本(找到, 1)])
        发射(上下文, "  call void @light_array_set_copy_tag(ptr " + 目标 + ", i64 " + 元素文本(下标, 0) + ", i32 " + 字符串(类型码(元素文本(值, 1))) + ", i64 " + 元素文本(值, 0) + ")")
        返回 0
    如果 种类 == "印":
        返回 生成打印(上下文, 语句[1])
    如果 种类 == "追加":
        容器 = 生成表达式(上下文, 语句[2])
        值 = 生成表达式(上下文, 语句[3])
        p = 取指针(上下文, 容器)
        发射(上下文, "  call void @light_array_push_tag(ptr " + p + ", i32 " + 字符串(类型码(元素文本(值, 1))) + ", i64 " + 元素文本(值, 0) + ")")
        返回 0
    如果 种类 == "弹出":
        容器 = 生成表达式(上下文, 语句[2])
        p = 取指针(上下文, 容器)
        r = 新寄存器(上下文)
        发射(上下文, "  " + r + " = call i64 @light_array_pop(ptr " + p + ")")
        槽 = 新寄存器(上下文)
        发射(上下文, "  " + 槽 + " = alloca i64")
        发射(上下文, "  store i64 " + r + ", ptr " + 槽)
        追加(上下文[5], ["弹出结果", 槽, "未知"])
        返回 0
    如果 种类 == "如":
        条件 = 生成表达式(上下文, 语句[1])
        跳 = 真值(上下文, 元素文本(条件, 0))
        然后点 = 新标签(上下文, "then")
        否则点 = 新标签(上下文, "else")
        结束点 = 新标签(上下文, "ifend")
        发射(上下文, "  br i1 " + 跳 + ", label %" + 然后点 + ", label %" + 否则点)
        记跳转(上下文, "," + 然后点 + "," + 否则点 + ",")
        开块(上下文, 然后点)
        生成块(上下文, 语句[2])
        闭块(上下文, 结束点)
        开块(上下文, 否则点)
        如果 长度(语句) > 3:
            生成块(上下文, 语句[3])
        开块(上下文, 结束点)
        返回 0
    如果 种类 == "当":
        头 = 新标签(上下文, "whilehead")
        体 = 新标签(上下文, "whilebody")
        下一步 = 新标签(上下文, "next")
        跳出点 = 新标签(上下文, "brk")
        开块(上下文, 头)
        条件 = 生成表达式(上下文, 语句[1])
        跳 = 真值(上下文, 元素文本(条件, 0))
        发射(上下文, "  br i1 " + 跳 + ", label %" + 体 + ", label %" + 跳出点)
        记跳转(上下文, "," + 体 + "," + 跳出点 + ",")
        开块(上下文, 体)
        追加(上下文[6], [下一步, 跳出点])
        生成块(上下文, 语句[2])
        弹出(上下文[6])
        开块(上下文, 下一步)
        发射(上下文, "  br label %" + 头)
        记跳转(上下文, "," + 头 + ",")
        开块(上下文, 跳出点)
        返回 0
    如果 种类 == "返":
        如果 长度(语句) > 1:
            值 = 生成表达式(上下文, 语句[1])
            发射(上下文, "  store i64 " + 元素文本(值, 0) + ", ptr " + 上下文[7])
        发射(上下文, "  br label %" + 上下文[8])
        记跳转(上下文, "," + 上下文[8] + ",")
        返回 0
    如果 种类 == "出":
        栈 = 上下文[6]
        帧 = 栈[长度(栈) - 1]
        发射(上下文, "  br label %" + 元素文本(帧, 1))
        返回 0
    如果 种类 == "续":
        栈 = 上下文[6]
        帧 = 栈[长度(栈) - 1]
        发射(上下文, "  br label %" + 元素文本(帧, 0))
        返回 0
    如果 种类 == "汇":
        # 内联汇编：原样插进当前块
        发射(上下文, "  " + 语句[1])
        返回 0
    如果 种类 == "对":
        返回 生成对(上下文, 语句)
    如果 种类 == "断":
        返回 生成断言(上下文, 语句)
    如果 种类 == "抛":
        值 = 生成表达式(上下文, 语句[1])
        发射(上下文, "  call void @light_throw(ptr " + 取指针(上下文, 值) + ")")
        发射(上下文, "  call void @light_sys_exit(i64 1)")
        上下文[10] = 1
        返回 0
    如果 种类 == "试":
        返回 生成尝试(上下文, 语句)
    如果 种类 == "程":
        返回 生成线程(上下文, 语句)
    如果 种类 == "调用":
        生成表达式(上下文, 语句[1])
        返回 0
    如果 种类 == "表":
        值 = 生成表达式(上下文, 语句[1])
        返回 生成打印一个(上下文, 值)
    出错("无法生成的语句：" + 种类)
    返回 0

函数 生成对(上下文: 列表, 语句: 列表) -> 整数:
    # 对于 名 在 可迭代:  -> 按下标遍历数组
    序列 = 生成表达式(上下文, 语句[2])
    ap = 取指针(上下文, 序列)
    长度寄存器 = 新寄存器(上下文)
    发射(上下文, "  " + 长度寄存器 + " = call i64 @light_array_len(ptr " + ap + ")")
    计数器 = 新寄存器(上下文)
    追加(上下文[14], "  " + 计数器 + " = alloca i64")
    零 = 新寄存器(上下文)
    发射(上下文, "  " + 零 + " = add i64 0, 0")
    发射(上下文, "  store i64 " + 零 + ", ptr " + 计数器)
    头 = 新标签(上下文, "forhead")
    体 = 新标签(上下文, "forbody")
    步 = 新标签(上下文, "forstep")
    结束 = 新标签(上下文, "forend")
    发射(上下文, "  br label %" + 头)
    记跳转(上下文, "," + 头 + ",")
    开块(上下文, 头)
    下标 = 新寄存器(上下文)
    发射(上下文, "  " + 下标 + " = load i64, ptr " + 计数器)
    谓词 = 新寄存器(上下文)
    发射(上下文, "  " + 谓词 + " = icmp slt i64 " + 下标 + ", " + 长度寄存器)
    发射(上下文, "  br i1 " + 谓词 + ", label %" + 体 + ", label %" + 结束)
    记跳转(上下文, "," + 体 + "," + 结束 + ",")
    开块(上下文, 体)
    元素值 = 新寄存器(上下文)
    发射(上下文, "  " + 元素值 + " = call i64 @light_array_get(ptr " + ap + ", i64 " + 下标 + ")")
    变量槽 = 新寄存器(上下文)
    追加(上下文[14], "  " + 变量槽 + " = alloca i64")
    发射(上下文, "  store i64 " + 元素值 + ", ptr " + 变量槽)
    # 循环变量的作用域只在本循环内：记下表长，结束后截断，
    # 否则同名的下一个循环变量会复用上一个循环变量的槽位
    表长 = 长度(上下文[5])
    追加(上下文[5], [元素文本(语句, 1), 变量槽, "未知"])
    追加(上下文[6], [步, 结束])
    生成块(上下文, 语句[3])
    弹出(上下文[6])
    新表 = []
    k3 = 0
    当 k3 < 表长:
        追加(新表, 上下文[5][k3])
        k3 = k3 + 1
    上下文[5] = 新表
    闭块(上下文, 步)
    开块(上下文, 步)
    下标2 = 新寄存器(上下文)
    发射(上下文, "  " + 下标2 + " = load i64, ptr " + 计数器)
    加一 = 新寄存器(上下文)
    发射(上下文, "  " + 加一 + " = add i64 " + 下标2 + ", 1")
    发射(上下文, "  store i64 " + 加一 + ", ptr " + 计数器)
    发射(上下文, "  br label %" + 头)
    记跳转(上下文, "," + 头 + ",")
    开块(上下文, 结束)
    返回 0

函数 生成断言(上下文: 列表, 语句: 列表) -> 整数:
    # 断言默认关闭：只有 LIGHT_DEBUG_ASSERTS 非空时才生成检查代码
    开关 = 环境变量("LIGHT_DEBUG_ASSERTS")
    如果 开关 == "":
        返回 0
    条件 = 生成表达式(上下文, 语句[1])
    跳 = 真值(上下文, 元素文本(条件, 0))
    通过 = 新标签(上下文, "assertok")
    失败 = 新标签(上下文, "assertfail")
    发射(上下文, "  br i1 " + 跳 + ", label %" + 通过 + ", label %" + 失败)
    记跳转(上下文, "," + 通过 + "," + 失败 + ",")
    开块(上下文, 失败)
    消息 = 造字符串(上下文, 元素文本(语句[2], 1))
    数据 = 新寄存器(上下文)
    发射(上下文, "  " + 数据 + " = call ptr @light_str_ptr(ptr " + 取指针(上下文, [消息, "字符串"]) + ")")
    长度寄存器 = 新寄存器(上下文)
    发射(上下文, "  " + 长度寄存器 + " = call i64 @light_str_len(ptr " + 取指针(上下文, [消息, "字符串"]) + ")")
    发射(上下文, "  call void @light_print_str(ptr " + 数据 + ", i64 " + 长度寄存器 + ")")
    发射(上下文, "  call void @light_print_newline()")
    发射(上下文, "  call void @light_sys_exit(i64 1)")
    发射(上下文, "  unreachable")
    上下文[10] = 1
    开块(上下文, 通过)
    返回 0

函数 生成抛出块(上下文: 列表, 块: 列表, 目标: 字符串) -> 布尔:
    # 返回真表示块已无条件终止（抛出/返回）
    i = 0
    当 i < 长度(块):
        s = 块[i]
        k = 元素文本(s, 0)
        如果 k == "抛":
            值 = 生成表达式(上下文, s[1])
            发射(上下文, "  call void @light_throw(ptr " + 取指针(上下文, 值) + ")")
            记跳转(上下文, "," + 目标 + ",")
            发射(上下文, "  br label %" + 目标)
            返回 真
        如果 k == "返":
            生成语句(上下文, s)
            返回 真
        如果 k == "断" 或 k == "抛" 或 k == "出" 或 k == "续":
            生成语句(上下文, s)
            返回 上下文[10] == 1
        生成语句(上下文, s)
        i = i + 1
    返回 假

函数 生成尝试(上下文: 列表, 语句: 列表) -> 整数:
    捕获点 = 新标签(上下文, "trycatch")
    最后点 = 新标签(上下文, "tryfinally")
    结束点 = 新标签(上下文, "tryend")
    长度前 = 长度(上下文[5])
    目标 = 最后点
    如果 元素文本(语句, 2) != "":
        目标 = 捕获点
    生成抛出块(上下文, 语句[1], 目标)
    # 收窄本块内定义的变量：抛出会跳到捕获块，不该带过去
    裁剪变量(上下文, 长度前)
    如果 长度(元素文本(语句, 2)) == 0:
        发射(上下文, "  br label %" + 最后点)
        记跳转(上下文, "," + 最后点 + ",")
    否则:
        发射(上下文, "  br label %" + 最后点)
        记跳转(上下文, "," + 最后点 + ",")
        开块(上下文, 捕获点)
        错误 = 新寄存器(上下文)
        发射(上下文, "  " + 错误 + " = call ptr @light_take_error()")
        错误值 = 新寄存器(上下文)
        发射(上下文, "  " + 错误值 + " = ptrtoint ptr " + 错误 + " to i64")
        错误槽 = 新寄存器(上下文)
        追加(上下文[14], "  " + 错误槽 + " = alloca i64")
        发射(上下文, "  store i64 " + 错误值 + ", ptr " + 错误槽)
        追加(上下文[5], [元素文本(语句, 2), 错误槽, "字符串"])
        生成块(上下文, 语句[3])
        裁剪变量(上下文, 长度前)
        闭块(上下文, 最后点)
    开块(上下文, 最后点)
    如果 长度(语句[4]) > 0:
        生成块(上下文, 语句[4])
    闭块(上下文, 结束点)
    开块(上下文, 结束点)
    返回 0

函数 裁剪变量(上下文: 列表, 长度前: 整数) -> 整数:
    # 只保留进入 try 之前就有的变量
    新表 = []
    i = 0
    当 i < 长度前:
        追加(新表, 上下文[5][i])
        i = i + 1
    上下文[5] = 新表
    返回 0

函数 生成线程(上下文: 列表, 语句: 列表) -> 整数:
    # 线程体要单独编成一个函数，但不能在这里换掉 上下文[0]：
    # 把列表存进局部变量后函数返回时会被释放，外层上下文就成了悬垂指针。
    # 所以先把线程项挂到 上下文[15]，等主函数全部生成完再统一补上函数体。
    追加(上下文[15], 语句)
    任务 = 新寄存器(上下文)
    发射(上下文, "  " + 任务 + " = call ptr @light_thread_spawn(ptr @__light_thread_" + 语句[1] + ", i64 " + 语句[1] + ")")
    返回 0

函数 生成线程函数(上下文: 列表, 线程项: 列表) -> 整数:
    符号 = "__light_thread_" + 线程项[1]
    块 = 线程项[2]
    存待插 = 上下文[14]
    存入口点 = 上下文[13]
    存变量数 = 长度(上下文[5])
    存循环数 = 长度(上下文[6])
    存结果槽 = 上下文[7]
    存结束标签 = 上下文[8]
    上下文[14] = []
    上下文[13] = 0
    上下文[10] = 0
    上下文[12] = ""
    追加(上下文[6], ["__thread_next", "__thread_end"])
    发射(上下文, "define i64 @" + 符号 + "(i64 %thread_id) {")
    发射(上下文, "entry:")
    上下文[13] = 长度(上下文[0])
    发射(上下文, "  %thread_slot = alloca i64")
    发射(上下文, "  store i64 %thread_id, ptr %thread_slot")
    结果槽 = 新寄存器(上下文)
    追加(上下文[14], "  " + 结果槽 + " = alloca i64")
    零 = 新寄存器(上下文)
    发射(上下文, "  " + 零 + " = add i64 0, 0")
    发射(上下文, "  store i64 " + 零 + ", ptr " + 结果槽)
    上下文[7] = 结果槽
    上下文[8] = "__thread_end"
    生成块(上下文, 块)
    插入入口(上下文)
    # 收尾：没终止就补一条跳转；已经终止（例如最后一句是 返回/跳出）就直接开新块
    # 收尾：__thread_next 与 __thread_end 都必须至少有一条指令（LLVM 不允许空基本块）
    如果 上下文[10] == 0:
        发射(上下文, "  br label %__thread_next")
        记跳转(上下文, ",__thread_next,")
        开块(上下文, "__thread_next")
    否则:
        发射(上下文, "__thread_next:")
        上下文[10] = 0
    发射(上下文, "  br label %__thread_end")
    记跳转(上下文, ",__thread_end,")
    开块(上下文, "__thread_end")
    发射(上下文, "  ret i64 0")
    上下文[10] = 1
    发射(上下文, "}")
    发射(上下文, "")
    上下文[14] = 存待插
    上下文[13] = 存入口点
    上下文[7] = 存结果槽
    上下文[8] = 存结束标签
    上下文[10] = 0
    上下文[12] = ""
    弹出(上下文[6])
    裁剪变量(上下文, 存变量数)
    当 长度(上下文[6]) > 存循环数:
        弹出(上下文[6])
    返回 0

函数 生成块(上下文: 列表, 块: 列表) -> 整数:
    i = 0
    当 i < 长度(块):
        生成语句(上下文, 块[i])
        i = i + 1
    返回 0

函数 未知类型() -> 字符串:
    返回 ""

函数 推断表达式类型(节点: 列表) -> 字符串:
    种类 = 元素文本(节点, 0)
    如果 种类 == "真字" 或 种类 == "假字":
        返回 "布尔"
    如果 种类 == "串字":
        返回 "字符串"
    如果 种类 == "浮字":
        返回 "浮点"
    如果 种类 == "空字":
        返回 "空"
    如果 种类 == "列字":
        返回 "列表"
    如果 种类 == "元组":
        返回 "元组"
    如果 种类 == "单":
        如果 元素文本(节点, 1) == "非":
            返回 "布尔"
        返回 "整数"
    如果 种类 == "双":
        算符 = 元素文本(节点, 1)
        如果 算符 == "==" 或 算符 == "!=" 或 算符 == "<" 或 算符 == ">" 或 算符 == "<=" 或 算符 == ">=" 或 算符 == "且" 或 算符 == "或":
            返回 "布尔"
        如果 算符 == "/":
            返回 "浮点"
        返回 "整数"
    如果 种类 == "调":
        # 内建函数的返回类型：够用的一小张表
        名 = 元素文本(节点, 1)
        如果 名 == "数组" 或 名 == "范围" 或 名 == "列表" 或 名 == "分割":
            返回 "列表"
        如果 名 == "字典":
            返回 "字典"
        如果 名 == "字符串" 或 名 == "合并" 或 名 == "元素文本" 或 名 == "去空白" 或 名 == "替换" 或 名 == "大写" 或 名 == "小写" 或 名 == "读取文件" 或 名 == "环境变量" 或 名 == "执行" 或 名 == "输入" 或 名 == "字符" 或 名 == "读入":
            返回 "字符串"
        如果 名 == "浮点":
            返回 "浮点"
        如果 名 == "真":
            返回 "布尔"
        返回 "整数"
    返回 "整数"

函数 变量类型(块: 列表, 名字: 字符串) -> 字符串:
    # 扫函数体里 让 名 = 表达式，得到这个变量的类型
    i = 0
    当 i < 长度(块):
        s = 块[i]
        如果 元素文本(s, 0) == "让" 且 元素文本(s, 1) == 名字:
            返回 推断表达式类型(s[2])
        如果 元素文本(s, 0) == "设" 且 元素文本(s, 1) == 名字 且 长度(s) > 2:
            返回 推断表达式类型(s[2])
        i = i + 1
    返回 ""

函数 推断返回类型(块: 列表) -> 字符串:
    # 扫到第一个 返回 <表达式>，按表达式类型定返回值类型
    i = 0
    当 i < 长度(块):
        s = 块[i]
        如果 元素文本(s, 0) == "返":
            如果 长度(s) > 1:
                e = s[1]
                如果 元素文本(e, 0) == "变":
                    t = 变量类型(块, 元素文本(e, 1))
                    如果 t != "":
                        返回 t
                返回 推断表达式类型(e)
            返回 "空"
        如果 元素文本(s, 0) == "函":
            返回 推断返回类型(s[3])
        i = i + 1
    返回 "整数"

函数 建符号表(项目: 列表) -> 列表:
    表 = []
    序号 = 0
    i = 0
    当 i < 长度(项目):
        项 = 项目[i]
        如果 元素文本(项, 0) == "函":
            名 = 元素文本(项, 1)
            # 程序自己定义了 main：它就是入口，不要再套一层壳
            符号 = "_f" + 字符串(序号)
            如果 名 == "main":
                符号 = "main"
            参数数 = 长度(项[2])
            返回类型 = 元素文本(项, 4)
            # 没有 -> 标注时按函数体推断
            如果 返回类型 == "整数":
                返回类型 = 推断返回类型(项[3])
            声明 = "declare i64 @" + 符号 + "("
            k = 0
            当 k < 参数数:
                如果 k > 0:
                    声明 = 声明 + ", "
                声明 = 声明 + "i64"
                k = k + 1
            声明 = 声明 + ")"
            形参类型们 = []
            k2 = 0
            当 k2 < 参数数:
                追加(形参类型们, [[元素文本(项[2][k2], 1)]])
                k2 = k2 + 1
            追加(表, [名, 符号, 返回类型, 声明, 字符串(参数数), 形参类型们])
            如果 名 != "main":
                序号 = 序号 + 1
        否则如果 元素文本(项, 0) == "外":
            # 外部函数：直接按原名声明
            名 = 元素文本(项, 1)
            参数数 = 长度(项[2])
            声明 = "declare i64 @" + 名 + "("
            k = 0
            当 k < 参数数:
                如果 k > 0:
                    声明 = 声明 + ", "
                声明 = 声明 + "i64"
                k = k + 1
            声明 = 声明 + ")"
            形参类型们2 = []
            k3 = 0
            当 k3 < 参数数:
                追加(形参类型们2, [["未知"]])
                k3 = k3 + 1
            追加(表, [名, 名, "整数", 声明, 字符串(参数数), 形参类型们2])
        i = i + 1
    返回 表

函数 生成函数(上下文: 列表, 定义: 列表) -> 整数:
    名 = 元素文本(定义, 1)
    参数表 = 定义[2]
    块 = 定义[3]
    符号 = 查符号(上下文, 名)
    参数数 = 长度(参数表)
    形参 = ""
    i = 0
    当 i < 参数数:
        如果 i > 0:
            形参 = 形参 + ", "
        形参 = 形参 + "i64 %p" + 字符串(i)
        i = i + 1
    发射(上下文, "define i64 @" + 元素文本(符号, 0) + "(" + 形参 + ") {")
    发射(上下文, "entry:")
    上下文[11] = "entry"
    上下文[13] = 长度(上下文[0])
    上下文[14] = []
    新表 = []
    i = 0
    当 i < 参数数:
        槽 = 新寄存器(上下文)
        发射(上下文, "  " + 槽 + " = alloca i64")
        发射(上下文, "  store i64 %p" + 字符串(i) + ", ptr " + 槽)
        追加(新表, [元素文本(参数表[i], 0), 槽, 元素文本(参数表[i], 1)])
        i = i + 1
    上下文[5] = 新表
    结果槽 = 新寄存器(上下文)
    发射(上下文, "  " + 结果槽 + " = alloca i64")
    零 = 新寄存器(上下文)
    发射(上下文, "  " + 零 + " = add i64 0, 0")
    发射(上下文, "  store i64 " + 零 + ", ptr " + 结果槽)
    结束 = 新标签(上下文, "funend")
    上下文[7] = 结果槽
    上下文[8] = 结束
    上下文[6] = []
    生成块(上下文, 块)
    插入入口(上下文)
    开块(上下文, 结束)
    出 = 新寄存器(上下文)
    发射(上下文, "  " + 出 + " = load i64, ptr " + 结果槽)
    发射(上下文, "  ret i64 " + 出)
    发射(上下文, "}")
    发射(上下文, "")
    返回 0

函数 有主函数(项目: 列表) -> 布尔:
    i = 0
    当 i < 长度(项目):
        项 = 项目[i]
        如果 元素文本(项, 0) == "函" 且 元素文本(项, 1) == "main":
            返回 真
        i = i + 1
    返回 假

函数 生成主函数(上下文: 列表, 项目: 列表) -> 整数:
    如果 有主函数(项目):
        返回 0
    发射(上下文, "define i64 @main() {")
    发射(上下文, "entry:")
    上下文[11] = "entry"
    上下文[13] = 长度(上下文[0])
    上下文[14] = []
    上下文[5] = []
    上下文[6] = []
    结果槽 = 新寄存器(上下文)
    发射(上下文, "  " + 结果槽 + " = alloca i64")
    零 = 新寄存器(上下文)
    发射(上下文, "  " + 零 + " = add i64 0, 0")
    发射(上下文, "  store i64 " + 零 + ", ptr " + 结果槽)
    上下文[7] = 结果槽
    上下文[8] = "mainend"
    i = 0
    当 i < 长度(项目):
        项 = 项目[i]
        如果 元素文本(项, 0) != "函":
            生成语句(上下文, 项)
        i = i + 1
    插入入口(上下文)
    发射(上下文, "  ret i64 0")
    发射(上下文, "}")
    发射(上下文, "")
    返回 0

