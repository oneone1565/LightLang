外部 lightrt_live_arrays()
外部 lightrt_live_strings()

函数 main():
    # 创建数组和字符串，使用后让作用域自动释放
    让 a = 数组(10)
    a[0] = 100
    让 s = "测试" + "字符串"

    如果 a[0] == 100:
        让 内层 = 数组(5)
        内层[0] = 1
        打印 "内层数组已使用"
    # 内层离开作用域自动释放

    # 重新赋值触发旧值释放
    a = 数组(3)
    s = "新值"

    # 查询运行时存活的堆对象数（应为 0：无泄漏）
    打印 lightrt_live_arrays()
    打印 lightrt_live_strings()

    返回 0
