导入 "英文.llang"

# 英文模式演示：这段程序除了字符串内容，全是英文写法，
# 与中文写法编译后行为完全一致。

fn fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fn main():
    print "英文模式运行中"

    let i = 0
    while i < 10:
        print "fib(" + str_of(i) + ") = " + str_of(fib(i))
        i = i + 1

    let nums = [5, 3, 9, 1]
    print "长度: " + str_of(len(nums))
    print "求和: " + str_of(sum(nums))
    print "最大: " + str_of(max(max(nums[0], nums[1]), max(nums[2], nums[3])))

    let name = "LightLang"
    print "大写: " + upper(name)
    print "长度: " + str_of(len(name))

    let total = 0
    for n in nums:
        if n > 2:
            total = total + n
    print "大于 2 的和: " + str_of(total)

    let f = 3.75
    print "浮点: " + str_of(f)
    print "转整数: " + str_of(int_of(f))

    return 0