# Light 语言扩展功能综合测试

函数 main():
    # 浮点数
    让 x = 3.14
    让 y = 2.0
    打印 x + y
    打印 x * y
    打印 x / y
    打印 x // y
    打印 2.0 ** 10.0

    # 整除与幂（整数）
    打印 7 // 2
    打印 2 ** 10
    打印 -7 // 2

    # 逻辑运算
    打印 真 且 假
    打印 真 或 假
    打印 非 真

    # elif
    让 n = 2
    如果 n == 1:
        打印 "一"
    否则如果 n == 2:
        打印 "二"
    否则如果 n == 3:
        打印 "三"
    否则:
        打印 "其他"

    # for-in 与 range
    让 总和 = 0
    对于 i 在 范围(5):
        总和 = 总和 + i
    打印 总和

    # break / continue
    让 s = 0
    对于 i 在 范围(10):
        如果 i == 5:
            跳出
        如果 i % 2 == 0:
            继续
        s = s + i
    打印 s

    # 内置函数
    让 arr = 数组(3)
    arr[0] = 10
    arr[1] = 20
    arr[2] = 30
    打印 长度(arr)
    打印 求和(arr)
    打印 最大(arr[0], arr[1])
    打印 最小(arr[0], arr[1])
    打印 绝对值(-42)

    # 类型转换
    打印 整数(3.9)
    打印 浮点(5)
    打印 字符串(123)
    打印 长度("你好")

    # 空值
    让 z = 空
    打印 z
