导入 "lightWeb"

# 官网首页 + HTTP 服务
#
#   nlightc examples/site.light -o /tmp/site
#   /tmp/site                    # 默认 8080
#   LIGHT_WEB_PORT=9000 /tmp/site
#
# 处理器必须返回字符串，页面元素逐个拼进去，最后用 页面完成() 收尾取回 HTML。

函数 首页(请求) -> 字符串:
    页面重置("LightLang", "none")
    页面主题("light")
    页面语言("zh-cn")
    追加样式(".lw-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem;margin:1rem 0}.lw-grid .lw-card{margin:0}h1{font-size:2.1rem;letter-spacing:-.02em;margin:.2rem 0}.lw-lead{opacity:.7;font-size:1.05rem;margin-top:-.4rem}")

    页元素开始("标题")
    页元素文本("LightLang")
    页元素结束()

    页元素开始("段落")
    页元素属性("类名", "lw-lead")
    页元素文本("用中文写程序，编译成原生机器码。")
    页元素结束()

    页元素开始("标签")
    页元素属性("颜色", "绿")
    页元素文本("稳定版 1.0")
    页元素结束()

    页元素开始("按钮")
    页元素属性("动作", "/start")
    页元素属性("方式", "get")
    页元素属性("样式", "主要")
    页元素文本("立即开始")
    页元素结束()

    页元素开始("链接")
    页元素属性("地址", "https://gitcode.com/NomiLight2026/lightLang")
    页元素文本("源码仓库")
    页元素结束()

    页元素开始("分隔线")
    页元素结束()

    页元素开始("标题")
    页元素属性("级别", "2")
    页元素文本("为什么是 LightLang")
    页元素结束()

    页元素开始("段落")
    页元素文本("整条工具链都能用同一种语言重写——编译器、运行时、工程工具，都是 Light 写的。")
    页元素结束()

    页元素开始("容器")
    页元素属性("元素", "div")
    页元素属性("类名", "lw-grid")

    页元素开始("卡片")
    页元素属性("标题", "自举编译器")
    页元素属性("内容", "编译器用 Light 实现，能编译自己并保持定点。")
    页元素结束()

    页元素开始("卡片")
    页元素属性("标题", "双运行时")
    页元素属性("内容", "Rust 版与 Light 版运行时输出逐字节一致，互为验证。")
    页元素结束()

    页元素开始("卡片")
    页元素属性("标题", "中文网页")
    页元素属性("内容", "页面元素直接用中文写，也能起 HTTP 服务。")
    页元素结束()

    页元素闭合()

    页元素开始("标题")
    页元素属性("级别", "2")
    页元素文本("工程进度")
    页元素结束()

    页元素开始("进度条")
    页元素属性("值", "100")
    页元素属性("最大", "100")
    页元素结束()

    页元素开始("进度条")
    页元素属性("值", "86")
    页元素属性("最大", "100")
    页元素结束()

    页元素开始("进度条")
    页元素属性("值", "35")
    页元素属性("最大", "100")
    页元素结束()

    页元素开始("分隔线")
    页元素结束()

    页元素开始("提示")
    页元素属性("级别", "信息")
    页元素文本("这是 Light 程序起的一个真实 HTTP 服务。")
    页元素结束()

    返回 页面完成()

路由("GET", "/", 首页)

# 传 0 表示读环境变量 LIGHT_WEB_PORT，没设就用 8080
启动(0)