# 动态类型元素、所有权转移、短路求值

函数 求和(数字们: 列表) -> 整数:
    总 = 0
    i = 0
    当 i < 长度(数字们):
        总 = 总 + 数字们[i]
        i = i + 1
    返回 总

# 列表元素类型编译期未知，用 元素文本 取文本形式
表格 = [["名字", "岁数"], ["小明", 18], ["小红", 20]]
i = 1
当 i < 长度(表格):
    行 = 表格[i]
    打印(元素文本(行, 0) + " : " + 元素文本(行, 1))
    i = i + 1

# 嵌套列表的下标读直接可用
打印(表格[0][0] + "-" + 表格[2][0])
打印("首元素文本：", 元素文本(表格[0], 0))

# 短路求值：右侧不会被求值
数字们 = [1, 2, 3]
打印(长度(数字们) < 2 且 数字们[99] == 0)
打印(长度(数字们) < 2 或 数字们[0] == 1)

# 字符串比较与所有权
甲 = "Light"
乙 = 甲
打印(字符串(甲 == 乙) + " " + 甲 + "-" + 乙)

# 动态下标：容器种类运行期才知道
任意 = 表格[1]
打印("任意长度：" + 字符串(长度(任意)) + "，文本：" + 字符串(任意))

打印("求和：" + 字符串(求和([4, 5, 6])))
