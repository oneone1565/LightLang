导入 "lightWeb"

# lightWeb 示例：编译后直接把页面导出成 HTML 文件
#
#   nlightc examples/web_page.light --page-out /tmp/page.html -o /tmp/page
#   /tmp/page                       # 运行后写出 HTML
#
# 属性名用中文约定：地址/名称/占位提示/样式/级别/默认值……
# 同一个程序也可以配合 启动(端口) 起 HTTP 服务。

页面(标题="Light Web 示例", 图标="none"):
    标题 "Light Web 示例"

    段落 "这个页面由 Light 程序生成，用 nlightc 编译运行后写出 HTML。"

    标题 "常用元素"
    段落 "标题、段落、链接、图片、输入框都可以直接写。"
    链接 "Light 语言主页" 地址="https://github.com"

    标题 "表单元素"
    输入框 名称="姓名" 占位提示="请输入姓名"
    按钮 "提交" 动作="/submit" 样式="主要"

    标题 "容器与卡片"
    容器:
        卡片:
            标题 "卡片标题"
            段落 "容器可以嵌套，卡片适合分组展示内容。"
        卡片:
            标题 "另一张卡片"
            标签 "新" 颜色="绿"

    标题 "代码块"
    代码块 "打印(\"你好\")"

    提示 "这是一条提示信息。" 样式="信息"

    分隔线
    段落 "—— 由 Light 生成 ——"