# 递归：斐波那契
函数 fib(n):
    如果 n < 2:
        返回 n
    返回 fib(n - 1) + fib(n - 2)

# 递归：阶乘
函数 fact(n):
    如果 n <= 1:
        返回 1
    返回 n * fact(n - 1)

# 判断素数
函数 is_prime(n):
    如果 n < 2:
        返回 假
    让 i = 2
    当 i * i <= n:
        如果 n % i == 0:
            返回 假
        i = i + 1
    返回 真

函数 main():
    打印 fib(10)
    打印 fact(6)
    打印 is_prime(17)
    打印 is_prime(15)
    返回 0
