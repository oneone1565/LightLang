导入 "lightWeb"

# 表单提交：读取查询串或表单参数
函数 提交(请求):
    名字 = 请求参数(请求, "名字")
    城市 = 请求参数(请求, "城市")
    如果 名字 == "":
        返回 "还没有收到参数，试试下面的表单。"
    返回 "收到：名字=" + 名字 + "，城市=" + 城市

路由("POST", "/submit", 提交)
路由("GET", "/submit", 提交)

页面 (标题="LightLang 前端元素" 图标=none):
    语言 = "zh-cn"
    主题 = "dark"

    标题 "LightLang 前端元素" 级别=1
    段落 "下面这些元素全部由 Light 语法生成，不需要写 HTML。"
    分隔线

    标题 "文字类" 级别=2
    段落 "段落文本，支持 {1 + 1} 这样的格式化。"
    代码块 "打印(\"你好\")"
    列表 项目=["列表项一", "列表项二", "列表项三"] 有序="真"
    表格 表头=["名称", "说明"] 行=[["按钮", "可提交表单"], ["输入框", "接收参数"]]

    标题 "交互类" 级别=2
    按钮 "直接提交" 动作="/submit" 方式=post 样式=主要
    按钮 "次要按钮" 样式=次要
    按钮 "危险按钮" 样式=危险
    链接 "LightLang 仓库" 地址="https://gitcode.com/NomiLight2026/lightLang"

    标题 "表单" 级别=2
    容器 元素=form 动作="/submit" 方式=post 标题="留言表单":
        输入框 名称="名字" 标签="你的名字" 占位提示="请输入名字"
        下拉框 名称="城市" 标签="所在城市" 选项=["北京", "上海", "广州"] 选中="上海"
        文本域 名称="留言" 占位提示="说点什么" 行数=4
        复选框 名称="同意" 文字="我已阅读条款" 选中="真"
        单选框 名称="性别" 文字="男" 值=m
        单选框 名称="性别" 文字="女" 值=f
        按钮 "发送"
    结束

    标题 "展示类" 级别=2
    提示 "这是一条成功提示" 级别=成功
    提示 "这是一条警告" 级别=警告
    卡片 标题="卡片标题" 内容="卡片内容，可以用 卡片 组合布局。"
    标签 "新" 颜色=绿
    标签 "热" 颜色=红
    标签 "灰" 颜色=灰
    进度条 值=72 最大=100
    图片 地址="https://example.com/logo.png" 替代文本="示例图片" 宽度=240
