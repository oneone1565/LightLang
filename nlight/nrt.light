# nlightRT —— 用 Light 实现的运行时（Nextlight 套件）
#
# 编译成静态库，替代 Rust 版 lightrt：
#   lightc nlight/nrt.light --no-lightrt --emit-llvm > target/nrt.ll
#   clang -c target/nrt.ll -o target/nrt.o
#   ar rcs target/libnlightrt.a target/nrt.o
#
# 机器层只有 8 个内建（内存分配/释放/复制/置零/整数读写/字节读写），
# 其余全部用标准 C 库函数（外部声明）实现。

外部 write(fd, buf, n)
外部 memcpy(dst, src, n)

# ---------------------------------------------------------------- LightStr
# 布局： [0] 数据指针 [1] 字节长度 [2] 容量    共 24 字节
# 字符串不可变，改长度就是新建一个。

函数 字符串头(大小: 整数) -> 整数:
    块 = 内存分配(24 + 大小)
    存内存整数(块, 块 + 24)
    存内存整数(块 + 8, 大小)
    存内存整数(块 + 16, 大小)
    返回 块

函数 light_str_from_utf8(数据: 整数, 字节数: 整数) -> 整数:
    如果 字节数 <= 0:
        返回 字符串头(0)
    串 = 字符串头(字节数)
    内存复制(内存整数(串), 数据, 字节数)
    返回 整数(串)

函数 light_str_new() -> 整数:
    返回 字符串头(0)

函数 light_str_ptr(串: 整数) -> 整数:
    如果 串 == 0:
        返回 0
    返回 内存整数(串)

函数 light_str_len(串: 整数) -> 整数:
    如果 串 == 0:
        返回 0
    返回 内存整数(串 + 8)

函数 light_str_free(串: 整数) -> 整数:
    如果 串 == 0:
        返回 0
    内存释放(串)
    返回 0

函数 light_str_dup(串: 整数) -> 整数:
    如果 串 == 0:
        返回 字符串头(0)
    返回 light_str_from_utf8(内存整数(串), 内存整数(串 + 8))

函数 light_str_concat(甲: 整数, 乙: 整数) -> 整数:
    长甲 = light_str_len(甲)
    长乙 = light_str_len(乙)
    串 = 字符串头(长甲 + 长乙)
    如果 长甲 > 0:
        内存复制(内存整数(串), 内存整数(甲), 长甲)
    如果 长乙 > 0:
        内存复制(内存整数(串) + 长甲, 内存整数(乙), 长乙)
    返回 整数(串)

函数 light_str_cmp(甲: 整数, 乙: 整数) -> 整数:
    长甲 = light_str_len(甲)
    长乙 = light_str_len(乙)
    短 = 长甲
    如果 长乙 < 短:
        短 = 长乙
    i = 0
    当 i < 短:
        a = 内存字节(内存整数(甲) + i)
        b = 内存字节(内存整数(乙) + i)
        如果 a < b:
            返回 -1
        如果 a > b:
            返回 1
        i = i + 1
    如果 长甲 < 长乙:
        返回 -1
    如果 长甲 > 长乙:
        返回 1
    返回 0

函数 light_str_substr(串: 整数, 起: 整数, 止: 整数) -> 整数:
    长 = light_str_len(串)
    s = 起
    如果 s < 0:
        s = 0
    e = 止
    如果 e > 长:
        e = 长
    如果 s >= e:
        返回 字符串头(0)
    返回 light_str_from_utf8(内存整数(串) + s, e - s)

函数 light_str_find(串: 整数, 子: 整数) -> 整数:
    长 = light_str_len(串)
    子长 = light_str_len(子)
    如果 子长 == 0:
        返回 0
    如果 子长 > 长:
        返回 -1
    i = 0
    当 i + 子长 <= 长:
        命中 = 真
        k = 0
        当 k < 子长:
            如果 内存字节(内存整数(串) + i + k) != 内存字节(内存整数(子) + k):
                命中 = 假
                跳出
            k = k + 1
        如果 命中:
            返回 i
        i = i + 1
    返回 -1

函数 light_str_contains(串: 整数, 子: 整数) -> 整数:
    如果 light_str_find(串, 子) >= 0:
        返回 1
    返回 0

函数 light_str_upper(串: 整数) -> 整数:
    长 = light_str_len(串)
    新 = 字符串头(长)
    i = 0
    当 i < 长:
        c = 内存字节(内存整数(串) + i)
        如果 c >= 97 且 c <= 122:
            c = c - 32
        存内存字节(内存整数(新) + i, c)
        i = i + 1
    返回 新

函数 light_str_lower(串: 整数) -> 整数:
    长 = light_str_len(串)
    新 = 字符串头(长)
    i = 0
    当 i < 长:
        c = 内存字节(内存整数(串) + i)
        如果 c >= 65 且 c <= 90:
            c = c + 32
        存内存字节(内存整数(新) + i, c)
        i = i + 1
    返回 新

函数 light_str_trim(串: 整数) -> 整数:
    长 = light_str_len(串)
    s = 0
    e = 长
    当 s < e:
        c = 内存字节(内存整数(串) + s)
        如果 c == 32 或 c == 9 或 c == 10 或 c == 13:
            s = s + 1
            继续
        跳出
    当 e > s:
        c = 内存字节(内存整数(串) + e - 1)
        如果 c == 32 或 c == 9 或 c == 10 或 c == 13:
            e = e - 1
            继续
        跳出
    返回 light_str_substr(串, s, e)

函数 light_str_replace(串: 整数, 旧: 整数, 新: 整数) -> 整数:
    # 先数出现次数
    长 = light_str_len(串)
    旧长 = light_str_len(旧)
    新长 = light_str_len(新)
    如果 旧长 == 0:
        返回 light_str_dup(串)
    次数 = 0
    i = 0
    当 i + 旧长 <= 长:
        命中 = 真
        k = 0
        当 k < 旧长:
            如果 内存字节(内存整数(串) + i + k) != 内存字节(内存整数(旧) + k):
                命中 = 假
                跳出
            k = k + 1
        如果 命中:
            次数 = 次数 + 1
            i = i + 旧长
        否则:
            i = i + 1
    结果 = 字符串头(长 - 次数 * 旧长 + 次数 * 新长)
    填 = 0
    i = 0
    当 i < 长:
        命中 = 假
        如果 i + 旧长 <= 长:
            命中 = 真
            k = 0
            当 k < 旧长:
                如果 内存字节(内存整数(串) + i + k) != 内存字节(内存整数(旧) + k):
                    命中 = 假
                    跳出
                k = k + 1
        如果 命中:
            如果 新长 > 0:
                内存复制(内存整数(结果) + 填, 内存整数(新), 新长)
            填 = 填 + 新长
            i = i + 旧长
        否则:
            存内存字节(内存整数(结果) + 填, 内存字节(内存整数(串) + i))
            填 = 填 + 1
            i = i + 1
    返回 整数(结果)

函数 light_str_split(串: 整数, 分隔: 整数) -> 整数:
    # 返回带标签的数组：每段一个元素（标签 2 字符串）
    长 = light_str_len(串)
    分长 = light_str_len(分隔)
    段数 = 1
    如果 分长 > 0:
        i = 0
        当 i + 分长 <= 长:
            命中 = 真
            k = 0
            当 k < 分长:
                如果 内存字节(内存整数(串) + i + k) != 内存字节(内存整数(分隔) + k):
                    命中 = 假
                    跳出
                k = k + 1
            如果 命中:
                段数 = 段数 + 1
                i = i + 分长
            否则:
                i = i + 1
    段数组 = light_array_new(段数)
    段 = 0
    起 = 0
    i = 0
    当 i <= 长:
        命中 = 假
        如果 i < 长 且 分长 > 0:
            命中 = 真
            k = 0
            当 k < 分长:
                如果 内存字节(内存整数(串) + i + k) != 内存字节(内存整数(分隔) + k):
                    命中 = 假
                    跳出
                k = k + 1
        如果 命中:
            light_array_set_copy_tag(段数组, 段, 2, light_str_substr(串, 起, i))
            段 = 段 + 1
            i = i + 分长
            起 = i
        否则:
            i = i + 1
    light_array_set_copy_tag(段数组, 段, 2, light_str_substr(串, 起, 长))
    返回 整数(段数组)

# ---------------------------------------------------------------- 数字互转

函数 数字串(值: 整数) -> 整数:
    # 整数转十进制字符串
    如果 值 == 0:
        零块 = 内存分配(1)
        存内存字节(零块, 48)
        零串 = light_str_from_utf8(零块, 1)
        内存释放(零块)
        返回 整数(零串)
    正 = 1
    如果 值 < 0:
        正 = 0
        值 = -值
    缓冲 = 内存分配(24)
    内存置零(缓冲, 24)
    填 = 24
    当 值 > 0:
        填 = 填 - 1
        存内存字节(缓冲 + 填, 48 + 值 % 10)
        值 = 值 // 10
    如果 正 == 0:
        填 = 填 - 1
        存内存字节(缓冲 + 填, 45)
    结果 = light_str_from_utf8(缓冲 + 填, 24 - 填)
    内存释放(缓冲)
    # 指针当整数返回：Light 里指针就是 i64
    返回 整数(结果)

函数 light_int_to_str(值: 整数) -> 整数:
    返回 整数(数字串(值))

# ---------------------------------------------------------------- 打印

函数 左括号字节() -> 整数:
    返回 单字节串(91)      # [ : 列表

函数 右括号字节() -> 整数:
    返回 单字节串(93)      # ]

函数 逗号空格() -> 整数:
    返回 双字节串(44, 32)

函数 冒号空格() -> 整数:
    返回 双字节串(58, 32)

# ---- 机器层入口（machine.c）----
外部 nrt_math_sin(位)
外部 nrt_math_cos(位)
外部 nrt_math_tan(位)
外部 nrt_math_sqrt(位)
外部 nrt_math_log(位)
外部 nrt_math_log10(位)
外部 nrt_math_floor(位)
外部 nrt_math_ceil(位)
外部 nrt_math_pow(甲, 乙)
外部 nrt_math_pi()
外部 nrt_math_e()
外部 nrt_math_random()
外部 nrt_math_random_int(下, 上)
外部 nrt_floor_div(甲, 乙)
外部 nrt_pow_int(底, 指数)
外部 nrt_exit(码)
外部 nrt_strtod(数据, 长)
外部 nrt_ftoa_rt(位, 缓冲)
外部 nrt_throw(消息)
外部 nrt_take_error()
外部 nrt_thread_start(入口, 参数)
外部 nrt_thread_join(句柄)
外部 nrt_thread_join_all()
外部 nrt_oob(下标, 长度)
外部 nrt_cmdline(长度槽)
外部 nrt_note_string(增量)
外部 nrt_note_array(增量)
外部 nrt_note_dict(增量)


函数 换行文字() -> 整数:
    块 = 内存分配(1)
    存内存字节(块, 10)
    串 = light_str_from_utf8(块, 1)
    内存释放(块)
    返回 整数(串)

函数 单字节串(值: 整数) -> 整数:
    块 = 内存分配(1)
    存内存字节(块, 值)
    串 = light_str_from_utf8(块, 1)
    内存释放(块)
    返回 整数(串)

函数 双字节串(甲: 整数, 乙: 整数) -> 整数:
    块 = 内存分配(2)
    存内存字节(块, 甲)
    存内存字节(块 + 1, 乙)
    串 = light_str_from_utf8(块, 2)
    内存释放(块)
    返回 整数(串)

函数 字节串(值: 整数) -> 整数:
    块 = 内存分配(1)
    存内存字节(块, 值)
    串 = light_str_from_utf8(块, 1)
    内存释放(块)
    返回 整数(串)

函数 真文字() -> 整数:
    # 真（UTF-8: e7 9c 9f）
    块 = 内存分配(3)
    存内存字节(块, 231)
    存内存字节(块 + 1, 156)
    存内存字节(块 + 2, 159)
    串 = light_str_from_utf8(块, 3)
    内存释放(块)
    返回 整数(串)

函数 假文字() -> 整数:
    # 假（UTF-8: e5 81 87）
    块 = 内存分配(3)
    存内存字节(块, 229)
    存内存字节(块 + 1, 129)
    存内存字节(块 + 2, 135)
    串 = light_str_from_utf8(块, 3)
    内存释放(块)
    返回 整数(串)

函数 light_print_newline():
    串 = 换行文字()
    light_print_str(light_str_ptr(串), 1)
    light_str_free(串)
    返回 0

函数 light_print_str(数据: 整数, 字节数: 整数):
    如果 字节数 > 0:
        write(1, 数据, 字节数)
    返回 0

函数 light_eprint_str(数据: 整数, 字节数: 整数):
    如果 字节数 > 0:
        write(2, 数据, 字节数)
    返回 0

函数 light_print_int(值: 整数):
    串 = light_int_to_str(值)
    light_print_str(light_str_ptr(串), light_str_len(串))
    light_str_free(串)
    返回 0

函数 light_print_bool(值: 整数):
    串 = 0
    如果 值 != 0:
        串 = 真文字()
    否则:
        串 = 假文字()
    light_print_str(light_str_ptr(串), light_str_len(串))
    light_str_free(串)
    返回 0

函数 light_print_float(值: 整数):
    # 位模式：小数用定点近似，够打印用
    串 = light_float_to_str(值)
    light_print_str(light_str_ptr(串), light_str_len(串))
    light_str_free(串)
    返回 0

函数 二的幂(次: 整数) -> 整数:
    r = 1
    i = 0
    当 i < 次:
        r = r * 2
        i = i + 1
    返回 r

函数 无符号右移(值: 整数, 位数: 整数) -> 整数:
    # 逻辑右移：算术右移会把符号位带下来，这里改用除法近似
    返回 值 // 二的幂(位数)

函数 light_float_to_str(位: 整数) -> 整数:
    # double 的 i64 位模式 -> 文本。格式化交给机器层（libc 的 %g），
    # Light 侧的定点算法会丢精度，对不上参考实现。
    缓冲 = 内存分配(64)
    写了 = nrt_ftoa_rt(位, 缓冲)
    # 参考实现保证至少有一个小数点
    有点 = 假
    i = 0
    当 i < 写了:
        c = 内存字节(缓冲 + i)
        如果 c == 46 或 c == 101 或 c == 69:
            有点 = 真
            跳出
        i = i + 1
    如果 有点 == 假:
        存内存字节(缓冲 + 写了, 46)
        存内存字节(缓冲 + 写了 + 1, 48)
        写了 = 写了 + 2
    串 = light_str_from_utf8(缓冲, 写了)
    内存释放(缓冲)
    返回 整数(串)

函数 位数(值: 整数) -> 整数:
    如果 值 == 0:
        返回 1
    n = 0
    当 值 > 0:
        值 = 值 // 10
        n = n + 1
    返回 n

函数 写整数(数据: 整数, 值: 整数) -> 整数:
    # 从后往前写，再整体前移
    如果 值 == 0:
        存内存字节(数据, 48)
        返回 1
    数位 = 位数(值)
    临时 = 内存分配(24)
    i = 0
    当 值 > 0:
        存内存字节(临时 + 数位 - 1 - i, 48 + 值 % 10)
        值 = 值 // 10
        i = i + 1
    内存复制(数据, 临时, 数位)
    内存释放(临时)
    返回 数位

# ---------------------------------------------------------------- 数字互转

函数 light_str_to_int(串: 整数) -> 整数:
    i = 0
    符号 = 1
    n = light_str_len(串)
    如果 n > 0:
        c = 内存字节(light_str_ptr(串))
        如果 c == 45:
            符号 = -1
            i = 1
    值 = 0
    当 i < n:
        c = 内存字节(light_str_ptr(串) + i)
        如果 c < 48 或 c > 57:
            跳出
        值 = 值 * 10 + (c - 48)
        i = i + 1
    返回 值 * 符号

函数 light_byte_to_char(字节: 整数) -> 整数:
    块 = 内存分配(1)
    存内存字节(块, 字节)
    串 = light_str_from_utf8(块, 1)
    内存释放(块)
    返回 整数(串)

# ---------------------------------------------------------------- LightArray
# 布局： [0] 元素数据指针 [1] 字节数 [2] 容量 [3] 标签指针   共 32 字节
# 标签：0 整数 1 浮点 2 字符串 3 布尔 4 空 5 容器 6 字典 7 元组

函数 数组头(容量: 整数) -> 整数:
    块 = 内存分配(32)
    存内存整数(块, 内存分配(容量 * 16))
    # 新建时长度就是容量（与参考实现一致：数组(n) 立刻有 n 个槽）
    存内存整数(块 + 8, 容量)
    存内存整数(块 + 16, 容量)
    存内存整数(块 + 24, 内存分配(容量 * 4))
    内存置零(内存整数(块), 容量 * 16)
    内存置零(内存整数(块 + 24), 容量 * 4)
    返回 块

函数 light_argv() -> 整数:
    # 静态库拿不到 main 的 argv；这里尝试 /proc/self/cmdline，
    # 读不到就返回空列表（自举工具链走 stdin，不依赖命令行参数）。
    长度槽 = 内存分配(8)
    缓冲 = nrt_cmdline(长度槽)
    字节数 = 内存整数(长度槽)
    内存释放(长度槽)
    如果 缓冲 == 0:
        返回 空数组()
    段数 = 1
    i = 0
    当 i < 字节数:
        如果 内存字节(缓冲 + i) == 0:
            段数 = 段数 + 1
        i = i + 1
    结果 = light_array_new(段数)
    序 = 0
    起 = 0
    i = 0
    当 i <= 字节数:
        到头 = 假
        如果 i == 字节数:
            到头 = 真
        否则如果 内存字节(缓冲 + i) == 0:
            到头 = 真
        如果 到头:
            light_array_set_tag(结果, 序, 2, light_str_from_utf8(缓冲 + 起, i - 起))
            序 = 序 + 1
            起 = i + 1
        i = i + 1
    内存释放(缓冲)
    返回 整数(结果)

函数 空数组() -> 整数:
    返回 整数(light_array_new(0))

函数 light_array_new(容量: 整数) -> 整数:
    如果 容量 < 0:
        容量 = 0
    返回 数组头(容量)

函数 light_array_len(容器: 整数) -> 整数:
    容器 = light_untag(容器)
    如果 容器 == 0:
        返回 0
    返回 内存整数(容器 + 8)

函数 数组扩容(容器: 整数, 需要: 整数) -> 整数:
    容量 = 内存整数(容器 + 16)
    如果 容量 >= 需要:
        返回 容量
    新容量 = 容量 * 2
    如果 新容量 < 需要:
        新容量 = 需要
    如果 新容量 < 4:
        新容量 = 4
    存内存整数(容器, 内存分配(新容量 * 16))
    存内存整数(容器 + 16, 新容量)
    存内存整数(容器 + 24, 内存分配(新容量 * 4))
    内存置零(内存整数(容器), 新容量 * 16)
    内存置零(内存整数(容器 + 24), 新容量 * 4)
    返回 新容量

函数 light_array_set_tag(容器: 整数, 下标: 整数, 标签: 整数, 值: 整数):
    容器 = light_untag(容器)
    如果 容器 == 0:
        返回 0
    数组扩容(容器, 下标 + 1)
    存内存整数(内存整数(容器) + 下标 * 16, 值)
    存内存字节(内存整数(容器 + 24) + 下标, 标签)
    如果 下标 + 1 > 内存整数(容器 + 8):
        存内存整数(容器 + 8, 下标 + 1)
    返回 0

函数 light_array_set_copy_tag(容器: 整数, 下标: 整数, 标签: 整数, 值: 整数):
    # 字符串要复制一份；整数/浮点/布尔按值搬过去，容器按引用
    新值 = 值
    如果 标签 == 2:
        新值 = light_str_dup(值)
    light_array_set_tag(容器, 下标, 标签, 新值)
    返回 0

函数 light_array_get(容器: 整数, 下标: 整数) -> 整数:
    容器 = light_untag(容器)
    如果 容器 == 0:
        返回 0
    如果 下标 < 0 或 下标 >= 内存整数(容器 + 8):
        nrt_oob(下标, 内存整数(容器 + 8))
        返回 0
    返回 内存整数(内存整数(容器) + 下标 * 16)

函数 light_array_get_tag(容器: 整数, 下标: 整数) -> 整数:
    容器 = light_untag(容器)
    如果 容器 == 0 或 下标 < 0 或 下标 >= 内存整数(容器 + 8):
        返回 0
    返回 内存字节(内存整数(容器 + 24) + 下标)

函数 light_array_push_tag(容器: 整数, 标签: 整数, 值: 整数):
    容器 = light_untag(容器)
    light_array_set_tag(容器, 内存整数(容器 + 8), 标签, 值)
    返回 0

函数 light_array_free(容器: 整数):
    容器 = light_untag(容器)
    如果 容器 == 0:
        返回 0
    内存释放(内存整数(容器))
    内存释放(内存整数(容器 + 24))
    内存释放(容器)
    返回 0

# ---------------------------------------------------------------- 标签与动态值
# 标签：0 整数 1 浮点 2 字符串 3 布尔 4 空 5 数组 6 字典 7 元组
# 编码：高 8 位放标签，低 56 位放值（与参考实现一致）

函数 light_tagged(值: 整数, 标签: 整数) -> 整数:
    返回 (标签 * 72057594037927936) + (值 % 72057594037927936)

函数 light_untag(值: 整数) -> 整数:
    返回 值 % 72057594037927936

函数 light_tag_of(值: 整数) -> 整数:
    返回 无符号右移(值, 56) % 8

函数 light_dynamic_len(值: 整数) -> 整数:
    标签 = light_tag_of(值)
    真值 = light_untag(值)
    如果 标签 == 2:
        返回 light_str_len(真值)
    如果 标签 == 5:
        返回 light_array_len(真值)
    如果 标签 == 6:
        返回 light_dict_len(真值)
    返回 0

函数 light_dynamic_get(容器值: 整数, 下标: 整数) -> 整数:
    标签 = light_tag_of(容器值)
    真值 = light_untag(容器值)
    如果 标签 == 2:
        串 = light_str_substr(真值, 下标, 下标 + 1)
        返回 light_tagged(light_str_ptr(串), 2)
    如果 标签 == 5:
        返回 light_tagged(light_array_get(真值, 下标), light_array_get_tag(真值, 下标))
    如果 标签 == 6:
        返回 light_tagged(light_dict_get(真值, 下标, 0), light_dict_get_tag(真值, 下标, 0))
    返回 light_tagged(0, 0)

函数 light_dynamic_contains(容器值: 整数, 目标: 整数) -> 整数:
    标签 = light_tag_of(容器值)
    真值 = light_untag(容器值)
    如果 标签 == 2:
        返回 light_str_contains(真值, light_untag(目标))
    如果 标签 == 5:
        返回 light_array_contains(真值, light_untag(目标))
    返回 0

函数 数组文本(容器: 整数) -> 整数:
    容量 = 64
    缓冲 = 内存分配(容量)
    填 = 0
    填 = 写字节(缓冲, 填, 91)
    长 = light_array_len(容器)
    i = 0
    当 i < 长:
        如果 i > 0:
            填 = 写字节(缓冲, 填, 44)
            填 = 写字节(缓冲, 填, 32)
        段 = light_dynamic_to_text(light_array_get(容器, i), light_array_get_tag(容器, i))
        填 = 写文本(缓冲, 填, 段)
        light_str_free(段)
        i = i + 1
    填 = 写字节(缓冲, 填, 93)
    串 = light_str_from_utf8(缓冲, 填)
    内存释放(缓冲)
    返回 整数(串)

函数 light_dynamic_to_text(值: 整数, 标签: 整数) -> 整数:
    如果 标签 == 0:
        返回 整数(light_int_to_str(值))
    如果 标签 == 1:
        返回 整数(light_float_to_str(值))
    如果 标签 == 2:
        # 复制一份：调用方会释放返回值，不能把原字符串的所有权带走
        返回 整数(light_str_dup(值))
    如果 标签 == 3:
        返回 整数(light_bool_to_str(值))
    如果 标签 == 5:
        返回 整数(数组文本(值))
    如果 标签 == 7:
        返回 数组文本(值)
    返回 light_str_new()

# ---------------------------------------------------------------- 杂项工具

函数 light_thread_join_all() -> 整数:
    返回 nrt_thread_join_all()

# ---------------------------------------------------------------- LightArray 其余

函数 指针(值: 整数) -> 整数:
    # 列表元素可能带运行期标签，作为指针传进来时先解掉
    返回 light_untag(值)

函数 light_array_get_raw(容器: 整数, 下标: 整数) -> 整数:
    返回 light_array_get(容器, 下标)

函数 light_array_tag_at(容器: 整数, 下标: 整数) -> 整数:
    返回 light_array_get_tag(容器, 下标)

函数 light_array_set(容器: 整数, 下标: 整数, 值: 整数):
    light_array_set_tag(容器, 下标, light_array_get_tag(容器, 下标), 值)
    返回 0

函数 light_array_push(容器: 整数, 值: 整数):
    light_array_set_tag(容器, light_array_len(容器), 0, 值)
    返回 0

函数 light_array_pop(容器: 整数) -> 整数:
    长 = light_array_len(容器)
    如果 长 == 0:
        返回 0
    值 = light_array_get(容器, 长 - 1)
    存内存整数(容器 + 8, 长 - 1)
    返回 值

函数 light_array_free_shallow(容器: 整数):
    如果 容器 == 0:
        返回 0
    内存释放(内存整数(容器))
    内存释放(内存整数(容器 + 24))
    内存释放(容器)
    返回 0

函数 light_array_concat(甲: 整数, 乙: 整数) -> 整数:
    长甲 = light_array_len(甲)
    长乙 = light_array_len(乙)
    结果 = light_array_new(长甲 + 长乙)
    i = 0
    当 i < 长甲:
        light_array_set_tag(结果, i, light_array_get_tag(甲, i), light_array_get(甲, i))
        i = i + 1
    i = 0
    当 i < 长乙:
        light_array_set_tag(结果, 长甲 + i, light_array_get_tag(乙, i), light_array_get(乙, i))
        i = i + 1
    返回 整数(结果)

函数 light_array_slice(容器: 整数, 起: 整数, 止: 整数) -> 整数:
    长 = light_array_len(容器)
    s = 起
    如果 s < 0:
        s = 0
    e = 止
    如果 e > 长:
        e = 长
    如果 s >= e:
        返回 light_array_new(0)
    结果 = light_array_new(e - s)
    i = s
    当 i < e:
        light_array_set_tag(结果, i - s, light_array_get_tag(容器, i), light_array_get(容器, i))
        i = i + 1
    返回 整数(结果)

函数 light_array_reverse(容器: 整数):
    长 = light_array_len(容器)
    i = 0
    当 i < 长 // 2:
        左值 = light_array_get(容器, i)
        左标 = light_array_get_tag(容器, i)
        右值 = light_array_get(容器, 长 - 1 - i)
        右标 = light_array_get_tag(容器, 长 - 1 - i)
        light_array_set_tag(容器, i, 右标, 右值)
        light_array_set_tag(容器, 长 - 1 - i, 左标, 左值)
        i = i + 1
    返回 0

函数 light_array_contains(容器: 整数, 目标: 整数) -> 整数:
    长 = light_array_len(容器)
    i = 0
    当 i < 长:
        如果 light_array_get(容器, i) == 目标:
            返回 1
        i = i + 1
    返回 0

函数 light_array_index(容器: 整数, 目标: 整数) -> 整数:
    长 = light_array_len(容器)
    i = 0
    当 i < 长:
        如果 light_array_get(容器, i) == 目标:
            返回 i
        i = i + 1
    返回 -1

函数 light_array_sort(容器: 整数):
    # 插入排序：元素少，够用
    i = 1
    长 = light_array_len(容器)
    当 i < 长:
        值 = light_array_get(容器, i)
        标 = light_array_get_tag(容器, i)
        j = i - 1
        当 j >= 0:
            如果 light_array_get(容器, j) > 值:
                light_array_set_tag(容器, j + 1, light_array_get_tag(容器, j), light_array_get(容器, j))
                j = j - 1
            否则:
                跳出
        light_array_set_tag(容器, j + 1, 标, 值)
        i = i + 1
    返回 0

函数 light_array_get_text(容器: 整数, 下标: 整数) -> 整数:
    容器 = light_untag(容器)
    返回 light_dynamic_to_text(light_array_get(容器, 下标), light_array_get_tag(容器, 下标))

函数 light_range(个数: 整数) -> 整数:
    如果 个数 < 0:
        个数 = 0
    结果 = light_array_new(个数)
    i = 0
    当 i < 个数:
        light_array_set_tag(结果, i, 0, i)
        i = i + 1
    返回 整数(结果)

# ---------------------------------------------------------------- LightDict
# 布局： [0] 键数据 [1] 值数据 [2] 标签数据 [3] 容量 [4] 长度

函数 字典头(容量: 整数) -> 整数:
    块 = 内存分配(40)
    存内存整数(块, 内存分配(容量 * 16))
    存内存整数(块 + 8, 内存分配(容量 * 16))
    存内存整数(块 + 16, 内存分配(容量 * 4))
    存内存整数(块 + 24, 容量)
    存内存整数(块 + 32, 0)
    返回 块

函数 light_dict_new() -> 整数:
    返回 字典头(8)

函数 light_dict_len(字典: 整数) -> 整数:
    字典 = light_untag(字典)
    如果 字典 == 0:
        返回 0
    返回 内存整数(字典 + 32)

函数 字典找位(字典: 整数, 键: 整数, 标签: 整数) -> 整数:
    容量 = 内存整数(字典 + 24)
    长 = 内存整数(字典 + 32)
    标签表 = 内存整数(字典 + 16)
    位 = 键 % 容量
    如果 位 < 0:
        位 = 位 + 容量
    i = 0
    当 i < 容量:
        如果 内存字节(标签表 + 位) == 255:
            返回 -位 - 1
        如果 内存字节(标签表 + 位) == 标签:
            如果 内存整数(内存整数(字典) + 位 * 16) == 键:
                返回 位
        位 = 位 + 1
        如果 位 >= 容量:
            位 = 0
        i = i + 1
    返回 -长 - 1

函数 light_dict_set(字典: 整数, 键标签: 整数, 键: 整数, 值标签: 整数, 值: 整数):
    字典 = light_untag(字典)
    如果 字典 == 0:
        返回 0
    容量 = 内存整数(字典 + 24)
    位置 = 字典找位(字典, 键, 键标签)
    如果 位置 >= 0:
        存内存整数(内存整数(字典 + 8) + 位置 * 16, 值)
        存内存字节(内存整数(字典 + 16) + 位置, 键标签)
        返回 0
    # 没找到：找空位写入
    标签表 = 内存整数(字典 + 16)
    位 = 键 % 容量
    如果 位 < 0:
        位 = 位 + 容量
    i = 0
    当 i < 容量:
        如果 内存字节(标签表 + 位) == 255:
            存内存整数(内存整数(字典) + 位 * 16, 键)
            存内存整数(内存整数(字典 + 8) + 位 * 16, 值)
            存内存字节(标签表 + 位, 键标签)
            存内存整数(字典 + 32, 内存整数(字典 + 32) + 1)
            返回 0
        位 = 位 + 1
        如果 位 >= 容量:
            位 = 0
        i = i + 1
    返回 0

函数 light_dict_get(字典: 整数, 键标签: 整数, 键: 整数) -> 整数:
    字典 = light_untag(字典)
    如果 字典 == 0:
        返回 0
    位置 = 字典找位(字典, 键, 键标签)
    如果 位置 < 0:
        返回 0
    返回 内存整数(内存整数(字典 + 8) + 位置 * 16)

函数 light_dict_get_tag(字典: 整数, 键标签: 整数, 键: 整数) -> 整数:
    字典 = light_untag(字典)
    如果 字典 == 0:
        返回 0
    位置 = 字典找位(字典, 键, 键标签)
    如果 位置 < 0:
        返回 0
    返回 内存字节(内存整数(字典 + 16) + 位置)

函数 light_dict_has(字典: 整数, 键标签: 整数, 键: 整数) -> 整数:
    字典 = light_untag(字典)
    如果 字典 == 0:
        返回 0
    位置 = 字典找位(字典, 键, 键标签)
    如果 位置 < 0:
        返回 0
    返回 1

函数 light_dict_keys(字典: 整数) -> 整数:
    字典 = light_untag(字典)
    长 = light_dict_len(字典)
    结果 = light_array_new(长)
    容量 = 内存整数(字典 + 24)
    i = 0
    k = 0
    当 i < 容量:
        如果 内存字节(内存整数(字典 + 16) + i) != 255:
            light_array_set_tag(结果, k, 内存字节(内存整数(字典 + 16) + i), 内存整数(内存整数(字典) + i * 16))
            k = k + 1
        i = i + 1
    返回 整数(结果)

函数 light_dict_free(字典: 整数):
    字典 = light_untag(字典)
    如果 字典 == 0:
        返回 0
    内存释放(内存整数(字典))
    内存释放(内存整数(字典 + 8))
    内存释放(内存整数(字典 + 16))
    内存释放(字典)
    返回 0

# ---------------------------------------------------------------- 字符串其余

函数 light_str_index(串: 整数, 下标: 整数) -> 整数:
    字节 = 内存字节(light_str_ptr(串) + 下标)
    字节串(字节)

函数 light_str_join(容器: 整数, 分隔: 整数) -> 整数:
    长 = light_array_len(容器)
    如果 长 == 0:
        返回 light_str_new()
    分长 = light_str_len(分隔)
    总长 = 0
    i = 0
    当 i < 长:
        总长 = 总长 + light_str_len(light_array_get(容器, i))
        如果 i + 1 < 长:
            总长 = 总长 + 分长
        i = i + 1
    结果 = light_str_from_utf8(0, 总长)
    数据 = light_str_ptr(结果)
    填 = 0
    i = 0
    当 i < 长:
        段 = light_array_get(容器, i)
        段长 = light_str_len(段)
        如果 段长 > 0:
            内存复制(数据 + 填, light_str_ptr(段), 段长)
        填 = 填 + 段长
        如果 i + 1 < 长:
            内存复制(数据 + 填, light_str_ptr(分隔), 分长)
            填 = 填 + 分长
        i = i + 1
    返回 整数(结果)

函数 light_str_to_float(串: 整数) -> 整数:
    返回 nrt_strtod(light_str_ptr(串), light_str_len(串))

函数 旧版_str_to_float(串: 整数) -> 整数:
    # 只支持形如 "123.456" 的定点输入
    n = light_str_len(串)
    i = 0
    符号 = 1
    如果 n > 0:
        如果 内存字节(light_str_ptr(串)) == 45:
            符号 = -1
            i = 1
    整数位 = 0
    小数位 = 0
    小数 = 0
    看到点 = 0
    当 i < n:
        c = 内存字节(light_str_ptr(串) + i)
        如果 c == 46:
            看到点 = 1
            i = i + 1
            继续
        如果 c < 48 或 c > 57:
            跳出
        如果 看到点 == 0:
            整数位 = 整数位 * 10 + (c - 48)
        否则:
            小数位 = 小数位 + 1
            小数 = 小数 * 10 + (c - 48)
        i = i + 1
    # 值 = 整数位 + 小数 // 10^小数位  -> 定点 2^30
    定点 = 整数位 * 1073741824
    如果 小数位 > 0:
        定点 = 定点 + 小数 * 1073741824 // 十的幂(小数位)
    返回 定点 * 符号

函数 十的幂(次: 整数) -> 整数:
    r = 1
    i = 0
    当 i < 次:
        r = r * 10
        i = i + 1
    返回 r

函数 light_bool_to_str(值: 整数) -> 整数:
    如果 值 != 0:
        返回 真文字()
    返回 假文字()

函数 light_dict_get_text(字典: 整数, 键标签: 整数, 键: 整数) -> 整数:
    返回 整数(light_dynamic_to_text(light_dict_get(字典, 键标签, 键), light_dict_get_tag(字典, 键标签, 键)))

# ---------------------------------------------------------------- 打印

函数 light_print_value(值: 整数, 标签: 整数):
    文本 = light_dynamic_to_text(值, 标签)
    light_print_str(light_str_ptr(文本), light_str_len(文本))
    返回 0

函数 light_print_array(容器: 整数):
    左 = 左括号字节()
    右 = 右括号字节()
    light_print_str(light_str_ptr(左), 1)
    打印数组内容(容器)
    light_print_str(light_str_ptr(右), 1)
    light_str_free(左)
    light_str_free(右)
    返回 0

函数 light_print_tuple(容器: 整数):
    左 = 单字节串(40)      # (
    右 = 单字节串(41)      # )
    light_print_str(light_str_ptr(左), 1)
    打印数组内容(容器)
    light_print_str(light_str_ptr(右), 1)
    light_str_free(左)
    light_str_free(右)
    返回 0

函数 打印数组内容(容器: 整数) -> 整数:
    分隔 = 逗号空格()
    长 = light_array_len(容器)
    i = 0
    当 i < 长:
        如果 i > 0:
            light_print_str(light_str_ptr(分隔), 2)
        light_print_value(light_array_get(容器, i), light_array_get_tag(容器, i))
        i = i + 1
    light_str_free(分隔)
    返回 0

函数 light_print_dict(字典: 整数):
    左 = 左括号字节()
    右 = 右括号字节()
    分隔 = 逗号空格()
    冒号 = 冒号空格()
    light_print_str(light_str_ptr(左), 1)
    键们 = light_dict_keys(字典)
    长 = light_array_len(键们)
    i = 0
    当 i < 长:
        如果 i > 0:
            light_print_str(light_str_ptr(分隔), 2)
        键 = light_array_get(键们, i)
        键标 = light_array_get_tag(键们, i)
        light_print_value(键, 键标)
        light_print_str(light_str_ptr(冒号), 2)
        light_print_value(light_dict_get(字典, 键标, 键), light_dict_get_tag(字典, 键标, 键))
        i = i + 1
    light_print_str(light_str_ptr(右), 1)
    返回 0

# ---------------------------------------------------------------- 格式化输出
# light_format_v1(格式数据, 格式长, 名数据, 名长, 值们数组, 名数)
#   占位符：{名字} 按名字取值；{} 与 {0} 按位置取值；{{ }} 转义

函数 写字节(缓冲: 整数, 填: 整数, 字节: 整数) -> 整数:
    # 预留：调用方保证容量足够
    存内存字节(缓冲 + 填, 字节)
    返回 填 + 1

函数 写文本(缓冲: 整数, 填: 整数, 串: 整数) -> 整数:
    长 = light_str_len(串)
    如果 长 > 0:
        内存复制(缓冲 + 填, light_str_ptr(串), 长)
    返回 填 + 长

函数 键匹配(名数据: 整数, 名长: 整数, 键起: 整数, 键长: 整数) -> 整数:
    # 在 NUL 分隔的名字表里找同名项，返回序号，找不到返回 -1
    序 = 0
    i = 0
    当 i < 名长:
        j = i
        当 j < 名长 且 内存字节(名数据 + j) != 0:
            j = j + 1
        长 = j - i
        如果 长 == 键长:
            相同 = 真
            k = 0
            当 k < 键长:
                如果 内存字节(名数据 + i + k) != 内存字节(键起 + k):
                    相同 = 假
                    跳出
                k = k + 1
            如果 相同:
                返回 序
        序 = 序 + 1
        i = j + 1
    返回 -1

函数 取占位值(键起: 整数, 键长: 整数, 名数据: 整数, 名长: 整数, 值们: 整数, 名数: 整数, 自动: 整数) -> 整数:
    # 返回对应值的文本串；找不到返回 0
    位置 = -1
    如果 键长 == 0:
        位置 = 名数 + 自动
    否则如果 全是数字(键起, 键长):
        位置 = 名数 + 数字值(键起, 键长)
    否则:
        序 = 键匹配(名数据, 名长, 键起, 键长)
        如果 序 >= 0:
            位置 = 序
    如果 位置 < 0:
        返回 0
    如果 值们 == 0:
        返回 0
    如果 位置 >= light_array_len(值们):
        返回 0
    返回 light_dynamic_to_text(light_array_get(值们, 位置), light_array_get_tag(值们, 位置))

函数 全是数字(起: 整数, 长: 整数) -> 布尔:
    i = 0
    当 i < 长:
        c = 内存字节(起 + i)
        如果 c < 48 或 c > 57:
            返回 假
        i = i + 1
    返回 真

函数 数字值(起: 整数, 长: 整数) -> 整数:
    v = 0
    i = 0
    当 i < 长:
        v = v * 10 + (内存字节(起 + i) - 48)
        i = i + 1
    返回 v

函数 light_format_v1(格式数据: 整数, 格式长: 整数, 名数据: 整数, 名长: 整数, 值们: 整数, 名数: 整数) -> 整数:
    容量 = 格式长 + 128
    缓冲 = 内存分配(容量)
    填 = 0
    i = 0
    自动 = 0
    当 i < 格式长:
        c = 内存字节(格式数据 + i)
        # {{ 与 }}
        如果 c == 123 且 i + 1 < 格式长 且 内存字节(格式数据 + i + 1) == 123:
            填 = 写字节(缓冲, 填, 123)
            i = i + 2
            继续
        如果 c == 125 且 i + 1 < 格式长 且 内存字节(格式数据 + i + 1) == 125:
            填 = 写字节(缓冲, 填, 125)
            i = i + 2
            继续
        如果 c != 123:
            填 = 写字节(缓冲, 填, c)
            i = i + 1
            继续
        结束 = -1
        k = i + 1
        当 k < 格式长:
            如果 内存字节(格式数据 + k) == 125:
                结束 = k
                跳出
            k = k + 1
        如果 结束 < 0:
            填 = 写字节(缓冲, 填, 123)
            i = i + 1
            继续
        键起 = 格式数据 + i + 1
        键长 = 结束 - i - 1
        # 去掉首尾空格
        s = 0
        e = 键长
        当 s < e:
            如果 内存字节(键起 + s) == 32 或 内存字节(键起 + s) == 9:
                s = s + 1
            否则:
                跳出
        当 e > s:
            如果 内存字节(键起 + e - 1) == 32 或 内存字节(键起 + e - 1) == 9:
                e = e - 1
            否则:
                跳出
        键起 = 键起 + s
        键长 = e - s
        文本 = 取占位值(键起, 键长, 名数据, 名长, 值们, 名数, 自动)
        如果 文本 == 0:
            填 = 写字节(缓冲, 填, 123)
            填 = 写文本(缓冲, 填, light_str_from_utf8(键起, 键长))
            填 = 写字节(缓冲, 填, 125)
        否则:
            填 = 写文本(缓冲, 填, 文本)
            light_str_free(文本)
        如果 键长 == 0:
            自动 = 自动 + 1
        i = 结束 + 1
    结果 = light_str_from_utf8(缓冲, 填)
    内存释放(缓冲)
    返回 整数(结果)

# ---------------------------------------------------------------- 文件与环境

外部 open(path, flags)
外部 close(fd)
外部 read(fd, buf, n)
外部 lseek(fd, off, whence)
外部 unlink(path)
外部 getenv(name)
外部 system(cmd)

函数 light_file_exists(路径: 整数) -> 整数:
    编号 = open(light_str_ptr(路径), 0)
    如果 编号 < 0:
        返回 0
    close(编号)
    返回 1

函数 light_file_read(路径: 整数) -> 整数:
    编号 = open(light_str_ptr(路径), 0)
    如果 编号 < 0:
        返回 整数(light_str_new())
    lseek(编号, 0, 2)
    大小 = lseek(编号, 0, 1)
    lseek(编号, 0, 0)
    如果 大小 < 0:
        close(编号)
        返回 整数(light_str_new())
    缓冲 = 内存分配(大小 + 1)
    读入 = read(编号, 缓冲, 大小)
    close(编号)
    串 = light_str_from_utf8(缓冲, 读入)
    内存释放(缓冲)
    返回 整数(串)

函数 light_file_write(路径: 整数, 内容: 整数) -> 整数:
    返回 写文件(路径, 内容, 577)   # O_WRONLY|O_CREAT|O_TRUNC = 0x241

函数 light_file_append(路径: 整数, 内容: 整数) -> 整数:
    返回 写文件(路径, 内容, 1089)  # O_WRONLY|O_CREAT|O_APPEND = 0x441

函数 写文件(路径: 整数, 内容: 整数, 标志: 整数) -> 整数:
    编号 = open(light_str_ptr(路径), 标志)
    如果 编号 < 0:
        返回 0
    长 = light_str_len(内容)
    写 = write(编号, light_str_ptr(内容), 长)
    close(编号)
    如果 写 >= 0:
        返回 1
    返回 0

函数 light_sys_getenv(名字: 整数) -> 整数:
    值 = getenv(light_str_ptr(名字))
    如果 值 == 0:
        返回 整数(light_str_new())
    返回 整数(light_str_from_utf8(值, 长度到零(值)))

函数 长度到零(地址: 整数) -> 整数:
    n = 0
    当 内存字节(地址 + n) != 0:
        n = n + 1
    返回 n

函数 light_sys_exec(命令: 整数) -> 整数:
    system(light_str_ptr(命令))
    返回 整数(light_str_new())

函数 light_input() -> 整数:
    返回 整数(light_str_new())

函数 light_read_all_stdin() -> 整数:
    缓冲 = 内存分配(65536)
    总量 = 0
    当 真:
        读 = read(0, 缓冲 + 总量, 65536 - 总量)
        如果 读 <= 0:
            跳出
        总量 = 总量 + 读
        如果 总量 >= 65535:
            跳出
    串 = light_str_from_utf8(缓冲, 总量)
    内存释放(缓冲)
    返回 整数(串)

